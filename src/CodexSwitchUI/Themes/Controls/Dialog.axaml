<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexDialog">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.CardForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusLg}" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="MinWidth" Value="360" />
    <Setter Property="MaxWidth" Value="512" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <ThicknessTransition Property="Padding" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexDialog">
        <Border x:Name="PART_Surface"
                MinWidth="{TemplateBinding MinWidth}"
                MaxWidth="{TemplateBinding MaxWidth}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Grid RowDefinitions="Auto,Auto,Auto"
                ColumnDefinitions="*,Auto"
                RowSpacing="16"
                ColumnSpacing="12">
            <StackPanel x:Name="PART_Header"
                        Grid.Row="0"
                        Grid.Column="0"
                        Spacing="6"
                        IsVisible="{TemplateBinding HasHeader}">
              <TextBlock x:Name="PART_Title"
                         Text="{TemplateBinding Title}"
                         IsVisible="{TemplateBinding HasTitle}"
                         Foreground="{TemplateBinding Foreground}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="PART_Description"
                         Text="{TemplateBinding Description}"
                         IsVisible="{TemplateBinding HasDescription}"
                         Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{DynamicResource CodexSwitch.FontSizeSm}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Button x:Name="PART_Close"
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{TemplateBinding CloseCommand}"
                    FocusAdorner="{x:Null}"
                    IsVisible="{TemplateBinding IsCloseVisible}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="PART_CloseSurface"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{DynamicResource CodexSwitch.RadiusSm}">
                    <Grid>
                      <PathIcon x:Name="PART_CloseIcon"
                                Width="12"
                                Height="12"
                                Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M3.4 2L2 3.4L6.6 8L2 12.6L3.4 14L8 9.4L12.6 14L14 12.6L9.4 8L14 3.4L12.6 2L8 6.6Z" />
                      <ContentPresenter x:Name="PART_CloseContent"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="False" />
                    </Grid>
                  </Border>
                </ControlTemplate>
              </Button.Template>
              <ContentControl Content="{TemplateBinding CloseContent}" />
            </Button>

            <ContentPresenter x:Name="PART_Content"
                              Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding HasContent}" />

            <ContentPresenter x:Name="PART_Action"
                              Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Content="{TemplateBinding Action}"
                              IsVisible="{TemplateBinding HasAction}"
                              HorizontalAlignment="Right" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexDialog /template/ Border#PART_Surface">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <ThicknessTransition Property="BorderThickness" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexDialog /template/ Button#PART_Close">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexDialog:pointerover /template/ Border#PART_Surface">
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.RingBrush}" />
  </Style>

  <Style Selector="controls|CodexDialog.has-close-content /template/ PathIcon#PART_CloseIcon">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="controls|CodexDialog.has-close-content /template/ ContentPresenter#PART_CloseContent">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="controls|CodexDialog /template/ Button#PART_Close:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
  </Style>

  <Style Selector="controls|CodexDialog /template/ Button#PART_Close:pressed">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
</Styles>
