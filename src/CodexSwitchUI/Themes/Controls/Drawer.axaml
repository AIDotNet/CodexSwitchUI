<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexDrawer">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.CardForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusLg}" />
    <Setter Property="Padding" Value="0,10,24,24" />
    <Setter Property="MinWidth" Value="320" />
    <Setter Property="MaxWidth" Value="460" />
    <Setter Property="MinHeight" Value="220" />
    <Setter Property="MaxHeight" Value="420" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexDrawer">
        <Grid x:Name="PART_Root"
              RowDefinitions="Auto,*"
              ClipToBounds="False">
          <ContentPresenter x:Name="PART_Trigger"
                            Grid.Row="0"
                            Content="{TemplateBinding Trigger}"
                            ContentTemplate="{TemplateBinding TriggerTemplate}"
                            HorizontalAlignment="Left"
                            IsVisible="{TemplateBinding HasTrigger}" />

          <Grid x:Name="PART_Layer"
                Grid.Row="1"
                ClipToBounds="False">
            <Border x:Name="PART_Overlay"
                    Background="{DynamicResource CodexSwitch.ForegroundBrush}"
                    Opacity="0.42" />

            <Border x:Name="PART_Surface"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    MinWidth="{TemplateBinding MinWidth}"
                    MaxWidth="{TemplateBinding MaxWidth}"
                    MinHeight="{TemplateBinding MinHeight}"
                    MaxHeight="{TemplateBinding MaxHeight}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="50%,50%">
              <Grid RowDefinitions="Auto,Auto,*,Auto"
                    ColumnDefinitions="*,Auto"
                    RowSpacing="16"
                    ColumnSpacing="12">
                <Border x:Name="PART_Handle"
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Width="40"
                        Height="5"
                        Margin="0,0,0,2"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                        CornerRadius="999"
                        Cursor="SizeAll"
                        Opacity="0.36"
                        IsVisible="{TemplateBinding IsHandleVisible}" />

                <StackPanel x:Name="PART_Header"
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,2"
                            Spacing="6"
                            IsVisible="{TemplateBinding HasHeader}">
                  <TextBlock x:Name="PART_Title"
                             Text="{TemplateBinding Title}"
                             IsVisible="{TemplateBinding HasTitle}"
                             Foreground="{TemplateBinding Foreground}"
                             FontFamily="{TemplateBinding FontFamily}"
                             FontSize="18"
                             FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                  <TextBlock x:Name="PART_Description"
                             Text="{TemplateBinding Description}"
                             IsVisible="{TemplateBinding HasDescription}"
                             Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                             FontFamily="{TemplateBinding FontFamily}"
                             FontSize="{DynamicResource CodexSwitch.FontSizeSm}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Button x:Name="PART_Close"
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Command="{TemplateBinding DismissCommand}"
                        FocusAdorner="{x:Null}"
                        IsVisible="{TemplateBinding IsCloseVisible}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="PART_CloseSurface"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{DynamicResource CodexSwitch.RadiusSm}">
                        <Grid>
                          <PathIcon x:Name="PART_CloseIcon"
                                    Width="12"
                                    Height="12"
                                    Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M3.4 2L2 3.4L6.6 8L2 12.6L3.4 14L8 9.4L12.6 14L14 12.6L9.4 8L14 3.4L12.6 2L8 6.6Z" />
                          <ContentPresenter x:Name="PART_CloseContent"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="False" />
                        </Grid>
                      </Border>
                    </ControlTemplate>
                  </Button.Template>
                  <ContentControl Content="{TemplateBinding CloseContent}" />
                </Button>

                <ScrollViewer x:Name="PART_ContentScroll"
                              Grid.Row="2"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              IsScrollChainingEnabled="False"
                              IsVisible="{TemplateBinding HasContent}">
                  <ContentPresenter x:Name="PART_Content"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ScrollViewer>

                <ContentPresenter x:Name="PART_Footer"
                                  Grid.Row="3"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Content="{TemplateBinding Action}"
                                  IsVisible="{TemplateBinding HasAction}"
                                  HorizontalAlignment="Stretch" />
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexDrawer.has-trigger /template/ Grid#PART_Root">
    <Setter Property="RowSpacing" Value="10" />
  </Style>

  <Style Selector="controls|CodexDrawer.direction-bottom">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxWidth" Value="10000" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="CornerRadius" Value="12,12,0,0" />
  </Style>

  <Style Selector="controls|CodexDrawer.direction-top">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxWidth" Value="10000" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="0,0,12,12" />
  </Style>

  <Style Selector="controls|CodexDrawer.direction-right">
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="CornerRadius" Value="12,0,0,12" />
    <Setter Property="MaxHeight" Value="10000" />
  </Style>

  <Style Selector="controls|CodexDrawer.direction-left">
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="CornerRadius" Value="0,12,12,0" />
    <Setter Property="MaxHeight" Value="10000" />
  </Style>

  <Style Selector="controls|CodexDrawer.direction-bottom /template/ Border#PART_Surface">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>

  <Style Selector="controls|CodexDrawer.direction-top /template/ Border#PART_Surface">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="controls|CodexDrawer.direction-right /template/ Border#PART_Surface">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="controls|CodexDrawer.direction-left /template/ Border#PART_Surface">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="controls|CodexDrawer.closed /template/ Border#PART_Overlay">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="controls|CodexDrawer.open /template/ Border#PART_Overlay">
    <Setter Property="Opacity" Value="0.42" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>

  <Style Selector="controls|CodexDrawer.non-modal /template/ Border#PART_Overlay">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="controls|CodexDrawer.open /template/ Border#PART_Surface">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translate(0px, 0px)" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>

  <Style Selector="controls|CodexDrawer.closed.direction-bottom /template/ Border#PART_Surface">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, 32px)" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="controls|CodexDrawer.closed.direction-top /template/ Border#PART_Surface">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(0px, -32px)" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="controls|CodexDrawer.closed.direction-right /template/ Border#PART_Surface">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(32px, 0px)" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="controls|CodexDrawer.closed.direction-left /template/ Border#PART_Surface">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform" Value="translate(-32px, 0px)" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="controls|CodexDrawer.dragging /template/ Border#PART_Surface">
    <Setter Property="Opacity" Value="0.98" />
  </Style>

  <Style Selector="controls|CodexDrawer.has-handle /template/ Border#PART_Handle">
    <Setter Property="Opacity" Value="0.36" />
  </Style>

  <Style Selector="controls|CodexDrawer.close-on-drag /template/ Border#PART_Handle">
    <Setter Property="Cursor" Value="SizeAll" />
  </Style>

  <Style Selector="controls|CodexDrawer.drag-dismiss-ready /template/ Border#PART_Handle">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.PrimaryBrush}" />
    <Setter Property="Opacity" Value="0.86" />
  </Style>

  <Style Selector="controls|CodexDrawer.scale-background">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexDrawer.size-sm">
    <Setter Property="Padding" Value="0,8,18,18" />
    <Setter Property="MinHeight" Value="180" />
    <Setter Property="MaxHeight" Value="340" />
  </Style>

  <Style Selector="controls|CodexDrawer.size-lg">
    <Setter Property="Padding" Value="0,12,30,30" />
    <Setter Property="MinHeight" Value="280" />
    <Setter Property="MaxHeight" Value="560" />
  </Style>

  <Style Selector="controls|CodexDrawer.size-icon">
    <Setter Property="MinWidth" Value="{DynamicResource CodexSwitch.ControlHeightMd}" />
  </Style>

  <Style Selector="controls|CodexDrawer /template/ Border#PART_Surface">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <ThicknessTransition Property="BorderThickness" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexDrawer /template/ Border#PART_Overlay">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexDrawer /template/ Border#PART_Handle">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexDrawer /template/ Button#PART_Close">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexDrawer.has-close-content /template/ PathIcon#PART_CloseIcon">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="controls|CodexDrawer.has-close-content /template/ ContentPresenter#PART_CloseContent">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="controls|CodexDrawer /template/ Button#PART_Close:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
  </Style>

  <Style Selector="controls|CodexDrawer /template/ Button#PART_Close:pressed">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
</Styles>
