<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexCard">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.CardForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusLg}" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <ThicknessTransition Property="Padding" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Surface"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <StackPanel Spacing="16">
            <StackPanel x:Name="PART_Header"
                        Spacing="6"
                        IsVisible="{TemplateBinding HasHeader}">
              <TextBlock x:Name="PART_Title"
                         Text="{TemplateBinding Title}"
                         IsVisible="{TemplateBinding HasTitle}"
                         Foreground="{TemplateBinding Foreground}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="18"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
              <TextBlock x:Name="PART_Description"
                         Text="{TemplateBinding Description}"
                         IsVisible="{TemplateBinding HasDescription}"
                         Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{DynamicResource CodexSwitch.FontSizeSm}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <ContentPresenter x:Name="PART_Content"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              IsVisible="{TemplateBinding HasContent}" />

            <ContentPresenter x:Name="PART_Footer"
                              Content="{TemplateBinding Footer}"
                              IsVisible="{TemplateBinding HasFooter}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexCard.interactive">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="controls|CodexCard.interactive:pointerover">
    <Setter Property="Opacity" Value="0.96" />
  </Style>

  <Style Selector="controls|CodexCard.interactive:pointerover /template/ Border#PART_Surface">
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.RingBrush}" />
  </Style>
</Styles>
