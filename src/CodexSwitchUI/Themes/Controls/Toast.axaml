<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexToast">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.CardForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusLg}" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="MinWidth" Value="320" />
    <Setter Property="MaxWidth" Value="420" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <ThicknessTransition Property="Padding" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexToast">
        <Border x:Name="PART_Surface"
                MinWidth="{TemplateBinding MinWidth}"
                MaxWidth="{TemplateBinding MaxWidth}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="4,*,Auto,Auto"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="10">
            <Border x:Name="PART_Status"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Width="4"
                    Background="{TemplateBinding BorderBrush}"
                    CornerRadius="2" />
            <Grid x:Name="PART_Body"
                  Grid.Row="0"
                  Grid.Column="1"
                  Grid.RowSpan="2"
                  ColumnDefinitions="Auto,*">
              <ContentPresenter x:Name="PART_Icon"
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Margin="0,1,10,0"
                                Content="{TemplateBinding Icon}"
                                IsVisible="{TemplateBinding HasIcon}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top" />
              <StackPanel x:Name="PART_Text"
                          Grid.Column="1"
                          Spacing="4">
                <TextBlock x:Name="PART_Title"
                           Text="{TemplateBinding Title}"
                           IsVisible="{TemplateBinding HasTitle}"
                           Foreground="{TemplateBinding Foreground}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{DynamicResource CodexSwitch.FontSizeSm}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PART_Description"
                           Text="{TemplateBinding Description}"
                           IsVisible="{TemplateBinding HasDescription}"
                           Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{DynamicResource CodexSwitch.FontSizeSm}"
                           TextWrapping="Wrap" />
                <ContentPresenter x:Name="PART_Content"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  IsVisible="{TemplateBinding HasContent}" />
              </StackPanel>
            </Grid>

            <ContentPresenter x:Name="PART_Action"
                              Grid.Row="0"
                              Grid.RowSpan="2"
                              Grid.Column="2"
                              Content="{TemplateBinding Action}"
                              IsVisible="{TemplateBinding HasAction}"
                              VerticalAlignment="Center" />

            <Button x:Name="PART_Close"
                    Grid.Row="0"
                    Grid.Column="3"
                    Width="26"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Command="{TemplateBinding CloseCommand}"
                    FocusAdorner="{x:Null}"
                    IsVisible="{TemplateBinding IsCloseVisible}">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="PART_CloseSurface"
                          Background="{TemplateBinding Background}"
                          CornerRadius="{DynamicResource CodexSwitch.RadiusSm}">
                    <Grid>
                      <PathIcon x:Name="PART_CloseIcon"
                                Width="11"
                                Height="11"
                                Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M3.4 2L2 3.4L6.6 8L2 12.6L3.4 14L8 9.4L12.6 14L14 12.6L9.4 8L14 3.4L12.6 2L8 6.6Z" />
                      <ContentPresenter x:Name="PART_CloseContent"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="False" />
                    </Grid>
                  </Border>
                </ControlTemplate>
              </Button.Template>
              <ContentControl Content="{TemplateBinding CloseContent}" />
            </Button>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexToast /template/ Border#PART_Surface">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexToast:pointerover">
    <Setter Property="Opacity" Value="0.96" />
  </Style>

  <Style Selector="controls|CodexToast.has-close-content /template/ PathIcon#PART_CloseIcon">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="controls|CodexToast.has-close-content /template/ ContentPresenter#PART_CloseContent">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="controls|CodexToast /template/ Button#PART_Close:pointerover">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
  </Style>

  <Style Selector="controls|CodexToast.variant-destructive">
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.DestructiveBrush}" />
  </Style>

  <Style Selector="controls|CodexToast.variant-success">
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.SuccessBrush}" />
  </Style>

  <Style Selector="controls|CodexToast.variant-warning">
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.WarningBrush}" />
  </Style>

  <Style Selector="controls|CodexToast.variant-secondary">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.SecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.SecondaryForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.SecondaryBrush}" />
  </Style>

  <Style Selector="controls|CodexToast.variant-outline">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BorderBrush}" />
  </Style>

  <Style Selector="controls|CodexToast.variant-ghost">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="controls|CodexToast.variant-link">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
</Styles>
