<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexBreadcrumb">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexBreadcrumb">
        <ContentPresenter x:Name="PART_Navigation"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexBreadcrumb.size-sm">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="controls|CodexBreadcrumb.size-lg">
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
  </Style>

  <Style Selector="controls|CodexBreadcrumb:disabled">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbList">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal"
                    Spacing="6" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexBreadcrumbList">
        <ItemsPresenter x:Name="PART_List" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexBreadcrumbList.breadcrumb-list">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbList.size-sm /template/ ItemsPresenter#PART_List StackPanel">
    <Setter Property="Spacing" Value="4" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbList.size-lg /template/ ItemsPresenter#PART_List StackPanel">
    <Setter Property="Spacing" Value="8" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbItem">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexBreadcrumbItem">
        <ContentPresenter x:Name="PART_Item"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          VerticalAlignment="{TemplateBinding VerticalAlignment}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexBreadcrumbItem.current">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusSm}" />
    <Setter Property="Padding" Value="3,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <ThicknessTransition Property="Padding" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexBreadcrumbLink">
        <Border x:Name="PART_LinkRoot"
                MinHeight="{TemplateBinding MinHeight}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_LinkContent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink.breadcrumb-link">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink.has-href">
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink /template/ Border#PART_LinkRoot">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink:pointerover /template/ Border#PART_LinkRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink:pressed /template/ Border#PART_LinkRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.MutedBrush}" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink:focus-visible /template/ Border#PART_LinkRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.RingBrush}" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink.current">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink.current /template/ Border#PART_LinkRoot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink:disabled">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink.size-sm">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="2,1" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbLink.size-lg">
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="5,3" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbPage">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
    <Setter Property="Padding" Value="3,2" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <ThicknessTransition Property="Padding" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexBreadcrumbPage">
        <Border x:Name="PART_PageRoot"
                MinHeight="{TemplateBinding MinHeight}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_PageContent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexBreadcrumbPage.breadcrumb-page">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbPage.size-sm">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Padding" Value="2,1" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbPage.size-lg">
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="5,3" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbSeparator">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="Opacity" Value="0.72" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexBreadcrumbSeparator">
        <ContentPresenter x:Name="PART_Separator"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexBreadcrumbSeparator.breadcrumb-separator">
    <Setter Property="Opacity" Value="0.72" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbSeparator.size-sm">
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbSeparator.size-lg">
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbEllipsis">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.MutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusSm}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexBreadcrumbEllipsis">
        <Border x:Name="PART_EllipsisRoot"
                MinHeight="{TemplateBinding MinHeight}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter x:Name="PART_EllipsisContent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexBreadcrumbEllipsis.breadcrumb-ellipsis">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbEllipsis.size-sm">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="Padding" Value="5,0" />
  </Style>

  <Style Selector="controls|CodexBreadcrumbEllipsis.size-lg">
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="7,1" />
  </Style>
</Styles>
