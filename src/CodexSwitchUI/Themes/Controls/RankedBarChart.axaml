<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexRankedBarChart">
    <Setter Property="MinHeight" Value="226" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
    <Setter Property="MutedForeground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="TrackBrush" Value="{DynamicResource CodexSwitch.MutedBrush}" />
    <Setter Property="AccentBrush" Value="{DynamicResource CodexSwitch.PrimaryBrush}" />
    <Setter Property="SecondaryAccentBrush" Value="{DynamicResource CodexSwitch.SuccessBrush}" />
    <Setter Property="TertiaryAccentBrush" Value="{DynamicResource CodexSwitch.WarningBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusLg}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
    <Setter Property="RowHeight" Value="34" />
    <Setter Property="RowSpacing" Value="10" />
    <Setter Property="MaxVisibleItems" Value="5" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <ThicknessTransition Property="Padding" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexRankedBarChart.compact">
    <Setter Property="MinHeight" Value="206" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="RowHeight" Value="32" />
    <Setter Property="RowSpacing" Value="8" />
  </Style>

  <Style Selector="controls|CodexRankedBarChart:disabled">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>
</Styles>
