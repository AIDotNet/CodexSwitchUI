<Styles xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexSpinner">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <DoubleTransition Property="Width" Duration="0:0:0.15" />
        <DoubleTransition Property="Height" Duration="0:0:0.15" />
        <DoubleTransition Property="StrokeThickness" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSpinner.size-sm">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="MinHeight" Value="12" />
    <Setter Property="StrokeThickness" Value="1.75" />
  </Style>

  <Style Selector="controls|CodexSpinner.size-lg">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="StrokeThickness" Value="2.25" />
  </Style>

  <Style Selector="controls|CodexSpinner.size-icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="MinHeight" Value="16" />
  </Style>

  <Style Selector="controls|CodexSpinner.paused">
    <Setter Property="Opacity" Value="0.72" />
  </Style>

  <Style Selector="controls|CodexSpinner:disabled">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>
</Styles>
