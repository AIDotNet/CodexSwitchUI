<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexAspectRatio">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.MutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusMd}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <ThicknessTransition Property="Padding" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexAspectRatio">
        <Border x:Name="PART_Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                ClipToBounds="True">
          <Grid x:Name="PART_Viewport"
                ClipToBounds="True">
            <ContentPresenter x:Name="PART_ContentHost"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              IsVisible="{TemplateBinding HasContent}" />
            <TextBlock x:Name="PART_Empty"
                       Text="{TemplateBinding RatioText}"
                       Foreground="{TemplateBinding Foreground}"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsVisible="False" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexAspectRatio /template/ Border#PART_Root">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexAspectRatio /template/ ContentPresenter#PART_ContentHost">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexAspectRatio.aspect-ratio /template/ Border#PART_Root">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="controls|CodexAspectRatio.empty /template/ TextBlock#PART_Empty">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="controls|CodexAspectRatio.empty /template/ ContentPresenter#PART_ContentHost">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="controls|CodexAspectRatio.has-content /template/ ContentPresenter#PART_ContentHost">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexAspectRatio.ratio-square /template/ Border#PART_Root">
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.RingBrush}" />
  </Style>

  <Style Selector="controls|CodexAspectRatio.ratio-video /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
  </Style>

  <Style Selector="controls|CodexAspectRatio.ratio-portrait /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.SecondaryBrush}" />
  </Style>

  <Style Selector="controls|CodexAspectRatio.ratio-landscape /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.MutedBrush}" />
  </Style>

  <Style Selector="controls|CodexAspectRatio.fit-width /template/ TextBlock#PART_Empty,
                   controls|CodexAspectRatio.fit-height /template/ TextBlock#PART_Empty,
                   controls|CodexAspectRatio.fit-contain /template/ TextBlock#PART_Empty">
    <Setter Property="Opacity" Value="0.78" />
  </Style>

  <Style Selector="controls|CodexAspectRatio:pointerover /template/ Border#PART_Root">
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.RingBrush}" />
  </Style>

  <Style Selector="controls|CodexAspectRatio.size-sm">
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusSm}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
  </Style>

  <Style Selector="controls|CodexAspectRatio.size-lg">
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusLg}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeLg}" />
  </Style>

  <Style Selector="controls|CodexAspectRatio.size-icon">
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusMd}" />
  </Style>

  <Style Selector="controls|CodexAspectRatio:disabled">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>
</Styles>
