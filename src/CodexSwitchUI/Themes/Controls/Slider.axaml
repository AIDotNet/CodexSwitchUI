<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexSlider">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.PrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.SecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSlider:horizontal">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexSlider">
        <Border x:Name="PART_SliderRoot"
                Padding="{TemplateBinding Padding}"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource CodexSwitch.RadiusMd}">
          <Track x:Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                 Orientation="Horizontal">
            <Track.DecreaseButton>
              <RepeatButton x:Name="PART_DecreaseButton"
                            Background="{TemplateBinding Foreground}"
                            Focusable="False">
                <RepeatButton.Template>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            VerticalAlignment="Center" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton x:Name="PART_IncreaseButton"
                            Background="{TemplateBinding Background}"
                            Focusable="False">
                <RepeatButton.Template>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            VerticalAlignment="Center" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseButton>
            <Thumb x:Name="PART_Thumb"
                   Width="20"
                   Height="20"
                   Background="{DynamicResource CodexSwitch.BackgroundBrush}"
                   BorderBrush="{TemplateBinding BorderBrush}"
                   BorderThickness="{TemplateBinding BorderThickness}"
                   RenderTransform="none">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Border Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="10" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Track>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSlider:vertical">
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexSlider">
        <Border x:Name="PART_SliderRoot"
                Padding="{TemplateBinding Padding}"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource CodexSwitch.RadiusMd}">
          <Track x:Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                 Orientation="Vertical">
            <Track.DecreaseButton>
              <RepeatButton x:Name="PART_DecreaseButton"
                            Background="{TemplateBinding Foreground}"
                            Focusable="False">
                <RepeatButton.Template>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Width="4"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            HorizontalAlignment="Center" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton x:Name="PART_IncreaseButton"
                            Background="{TemplateBinding Background}"
                            Focusable="False">
                <RepeatButton.Template>
                  <ControlTemplate TargetType="RepeatButton">
                    <Border Width="4"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            HorizontalAlignment="Center" />
                  </ControlTemplate>
                </RepeatButton.Template>
              </RepeatButton>
            </Track.IncreaseButton>
            <Thumb x:Name="PART_Thumb"
                   Width="20"
                   Height="20"
                   Background="{DynamicResource CodexSwitch.BackgroundBrush}"
                   BorderBrush="{TemplateBinding BorderBrush}"
                   BorderThickness="{TemplateBinding BorderThickness}"
                   RenderTransform="none">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Border Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="10" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Track>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSlider /template/ Border#PART_SliderRoot">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <ThicknessTransition Property="BorderThickness" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSlider /template/ RepeatButton#PART_DecreaseButton, controls|CodexSlider /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSlider /template/ Thumb#PART_Thumb">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <DoubleTransition Property="Width" Duration="0:0:0.10" />
        <DoubleTransition Property="Height" Duration="0:0:0.10" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSlider:pointerover /template/ Thumb#PART_Thumb">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>

  <Style Selector="controls|CodexSlider:pressed /template/ Thumb#PART_Thumb">
    <Setter Property="RenderTransform" Value="scale(0.92)" />
  </Style>

  <Style Selector="controls|CodexSlider:focus /template/ Border#PART_SliderRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.RingBrush}" />
  </Style>

  <Style Selector="controls|CodexSlider:disabled">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>

  <Style Selector="controls|CodexSlider.size-sm /template/ Thumb#PART_Thumb">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <Style Selector="controls|CodexSlider.size-lg /template/ Thumb#PART_Thumb">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>

  <Style Selector="controls|CodexSlider.size-icon">
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <Style Selector="controls|CodexSlider.size-icon /template/ Thumb#PART_Thumb">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>

  <Style Selector="controls|CodexSlider.intent-error">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.DestructiveBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.DestructiveBrush}" />
  </Style>

  <Style Selector="controls|CodexSlider.intent-success">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.SuccessBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.SuccessBrush}" />
  </Style>

  <Style Selector="controls|CodexSlider.intent-warning">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.WarningBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.WarningBrush}" />
  </Style>
</Styles>
