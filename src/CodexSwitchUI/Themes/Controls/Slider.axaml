<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexSlider">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.PrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.SecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSlider:horizontal">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexSlider">
        <Border x:Name="PART_SliderRoot"
                Padding="{TemplateBinding Padding}"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource CodexSwitch.RadiusMd}">
          <Grid ClipToBounds="True">
            <Border x:Name="PART_TrackBackground"
                    Height="4"
                    Background="{TemplateBinding Background}"
                    CornerRadius="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />
            <Border x:Name="PART_TrackFill"
                    Width="{Binding Bounds.X, ElementName=PART_Thumb}"
                    Height="4"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
            <Track x:Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                   Orientation="Horizontal"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Center">
              <Track.DecreaseButton>
                <RepeatButton x:Name="PART_DecreaseButton"
                              Background="{TemplateBinding Foreground}"
                              Focusable="False"
                              Opacity="0">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4"
                              MinWidth="1"
                              Background="{TemplateBinding Background}"
                              CornerRadius="2"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton x:Name="PART_IncreaseButton"
                              Background="{TemplateBinding Background}"
                              Focusable="False"
                              Opacity="0">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4"
                              MinWidth="1"
                              Background="{TemplateBinding Background}"
                              CornerRadius="2"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseButton>
              <Track.Thumb>
                <Thumb x:Name="PART_Thumb"
                       Width="20"
                       Height="20"
                       Background="{DynamicResource CodexSwitch.BackgroundBrush}"
                       BorderBrush="{TemplateBinding BorderBrush}"
                       BorderThickness="{TemplateBinding BorderThickness}"
                       RenderTransform="none">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="10" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSlider:vertical">
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexSlider">
        <Border x:Name="PART_SliderRoot"
                Padding="{TemplateBinding Padding}"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource CodexSwitch.RadiusMd}">
          <Grid ClipToBounds="True">
            <Border x:Name="PART_TrackBackground"
                    Width="4"
                    Background="{TemplateBinding Background}"
                    CornerRadius="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch" />
            <Border x:Name="PART_TrackFill"
                    Width="4"
                    Height="{Binding Bounds.Y, ElementName=PART_Thumb}"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top" />
            <Track x:Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                   Orientation="Vertical"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Stretch">
              <Track.DecreaseButton>
                <RepeatButton x:Name="PART_DecreaseButton"
                              Background="{TemplateBinding Foreground}"
                              Focusable="False"
                              Opacity="0">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Width="4"
                              MinHeight="1"
                              Background="{TemplateBinding Background}"
                              CornerRadius="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton x:Name="PART_IncreaseButton"
                              Background="{TemplateBinding Background}"
                              Focusable="False"
                              Opacity="0">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Width="4"
                              MinHeight="1"
                              Background="{TemplateBinding Background}"
                              CornerRadius="2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseButton>
              <Track.Thumb>
                <Thumb x:Name="PART_Thumb"
                       Width="20"
                       Height="20"
                       Background="{DynamicResource CodexSwitch.BackgroundBrush}"
                       BorderBrush="{TemplateBinding BorderBrush}"
                       BorderThickness="{TemplateBinding BorderThickness}"
                       RenderTransform="none">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="10" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSlider /template/ Border#PART_SliderRoot">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <ThicknessTransition Property="BorderThickness" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSlider /template/ RepeatButton#PART_DecreaseButton, controls|CodexSlider /template/ RepeatButton#PART_IncreaseButton">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSlider /template/ Thumb#PART_Thumb">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <DoubleTransition Property="Width" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <DoubleTransition Property="Height" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexSlider:pointerover /template/ Thumb#PART_Thumb">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
  </Style>

  <Style Selector="controls|CodexSlider:pressed /template/ Thumb#PART_Thumb">
    <Setter Property="RenderTransform" Value="scale(0.92)" />
  </Style>

  <Style Selector="controls|CodexSlider.dragging /template/ Thumb#PART_Thumb">
    <Setter Property="RenderTransform" Value="scale(0.88)" />
  </Style>

  <Style Selector="controls|CodexSlider:focus-visible /template/ Border#PART_SliderRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.RingBrush}" />
  </Style>

  <Style Selector="controls|CodexSlider:disabled">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>

  <Style Selector="controls|CodexSlider.size-sm /template/ Thumb#PART_Thumb">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>

  <Style Selector="controls|CodexSlider.size-lg /template/ Thumb#PART_Thumb">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
  </Style>

  <Style Selector="controls|CodexSlider.size-icon">
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <Style Selector="controls|CodexSlider.size-icon /template/ Thumb#PART_Thumb">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>

  <Style Selector="controls|CodexSlider.intent-error">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.DestructiveBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.DestructiveBrush}" />
  </Style>

  <Style Selector="controls|CodexSlider.intent-success">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.SuccessBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.SuccessBrush}" />
  </Style>

  <Style Selector="controls|CodexSlider.intent-warning">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.WarningBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.WarningBrush}" />
  </Style>
</Styles>
