<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexTabs">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="0" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexTabs">
        <StackPanel x:Name="PART_Root"
                    Spacing="8">
          <Border x:Name="PART_List"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource CodexSwitch.MutedBrush}"
                  CornerRadius="{DynamicResource CodexSwitch.RadiusMd}"
                  Padding="3">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
            <ItemsPresenter />
          </Border>
          <Border x:Name="PART_Content"
                  Background="Transparent"
                  CornerRadius="{DynamicResource CodexSwitch.RadiusLg}">
            <TransitioningContentControl x:Name="PART_ContentTransitionHost"
                                         Content="{TemplateBinding SelectedContent}"
                                         ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                         VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
              <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.14" />
              </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
          </Border>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexTabs TabItem">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusSm}" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <ThicknessTransition Property="Padding" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid MinHeight="{TemplateBinding MinHeight}"
              MinWidth="{TemplateBinding MinWidth}">
          <Border x:Name="PART_TriggerRoot"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <ContentPresenter x:Name="PART_HeaderPresenter"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True" />
              <Border x:Name="PART_Indicator"
                      Height="2"
                      Margin="0,0,0,-5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Bottom"
                      Background="{DynamicResource CodexSwitch.ForegroundBrush}"
                      CornerRadius="1"
                      Opacity="0">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                  </Transitions>
                </Border.Transitions>
              </Border>
              <Border x:Name="PART_VerticalIndicator"
                      Width="2"
                      Margin="0,0,-5,0"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource CodexSwitch.ForegroundBrush}"
                      CornerRadius="1"
                      Opacity="0">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                  </Transitions>
                </Border.Transitions>
              </Border>
            </Grid>
          </Border>
          <Border x:Name="PART_FocusRing"
                  BorderBrush="{DynamicResource CodexSwitch.RingBrush}"
                  BorderThickness="3"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  IsHitTestVisible="False"
                  Opacity="0" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexTabs TabItem /template/ Border#PART_TriggerRoot">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <ThicknessTransition Property="BorderThickness" Duration="0:0:0.15" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexTabs TabItem /template/ Border#PART_FocusRing">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexTabs TabItem PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="controls|CodexTabs TabItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexTabs TabItem:focus /template/ Border#PART_TriggerRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.RingBrush}" />
  </Style>

  <Style Selector="controls|CodexTabs TabItem:focus /template/ Border#PART_FocusRing">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>

  <Style Selector="controls|CodexTabs TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexTabs TabItem:selected /template/ Border#PART_TriggerRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.BackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.InputBrush}" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #14000000" />
  </Style>

  <Style Selector="controls|CodexTabs TabItem:disabled">
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>

  <Style Selector="controls|CodexTabs.size-sm TabItem">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
  </Style>

  <Style Selector="controls|CodexTabs.size-lg TabItem">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="11,6" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeLg}" />
  </Style>

  <Style Selector="controls|CodexTabs.size-icon TabItem">
    <Setter Property="MinWidth" Value="{DynamicResource CodexSwitch.ControlHeightMd}" />
    <Setter Property="MinHeight" Value="{DynamicResource CodexSwitch.ControlHeightMd}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="controls|CodexTabs.vertical">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical" Spacing="0" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexTabs">
        <Grid x:Name="PART_Root"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="8">
          <Border x:Name="PART_List"
                  Grid.Column="0"
                  VerticalAlignment="Top"
                  Background="{DynamicResource CodexSwitch.MutedBrush}"
                  CornerRadius="{DynamicResource CodexSwitch.RadiusMd}"
                  Padding="3">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
              </Transitions>
            </Border.Transitions>
            <ItemsPresenter />
          </Border>
          <Border x:Name="PART_Content"
                  Grid.Column="1"
                  Background="Transparent"
                  CornerRadius="{DynamicResource CodexSwitch.RadiusLg}">
            <TransitioningContentControl x:Name="PART_ContentTransitionHost"
                                         Content="{TemplateBinding SelectedContent}"
                                         ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                         VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
              <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.14" />
              </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexTabs.vertical TabItem">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style Selector="controls|CodexTabs.variant-line">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="4" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexTabs.variant-line /template/ Border#PART_List">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="3" />
  </Style>

  <Style Selector="controls|CodexTabs.variant-line TabItem">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <Style Selector="controls|CodexTabs.variant-line TabItem:pointerover /template/ Border#PART_TriggerRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="controls|CodexTabs.variant-line TabItem:selected /template/ Border#PART_TriggerRoot">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
  </Style>

  <Style Selector="controls|CodexTabs.horizontal.variant-line TabItem:selected /template/ Border#PART_Indicator">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexTabs.vertical.variant-line">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Vertical" Spacing="4" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexTabs.vertical.variant-line TabItem:selected /template/ Border#PART_VerticalIndicator">
    <Setter Property="Opacity" Value="1" />
  </Style>
</Styles>
