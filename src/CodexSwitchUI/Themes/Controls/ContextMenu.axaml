<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexContextMenu">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.PopoverForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.PopoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusMd}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="128" />
    <Setter Property="MaxHeight" Value="320" />
    <Setter Property="Placement" Value="Pointer" />
    <Setter Property="WindowManagerAddShadowHint" Value="False" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexContextMenu">
        <Border x:Name="PART_Surface"
                MinWidth="{TemplateBinding MinWidth}"
                MaxHeight="{TemplateBinding MaxHeight}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                Opacity="0"
                RenderTransform="translate(0px, -8px) scale(0.95)"
                RenderTransformOrigin="0%,0%">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        IsScrollChainingEnabled="False">
            <ItemsPresenter x:Name="PART_ItemsPresenter" />
          </ScrollViewer>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexContextMenu.loading">
    <Setter Property="Opacity" Value="0.84" />
  </Style>

  <Style Selector="controls|CodexContextMenu /template/ Border#PART_Surface, controls|CodexContextMenu MenuItem /template/ Border#PART_SubMenuSurface">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexContextMenu.side-top /template/ Border#PART_Surface">
    <Setter Property="RenderTransform" Value="translate(0px, 8px) scale(0.95)" />
    <Setter Property="RenderTransformOrigin" Value="0%,100%" />
  </Style>

  <Style Selector="controls|CodexContextMenu.side-left /template/ Border#PART_Surface">
    <Setter Property="RenderTransform" Value="translate(8px, 0px) scale(0.95)" />
    <Setter Property="RenderTransformOrigin" Value="100%,0%" />
  </Style>

  <Style Selector="controls|CodexContextMenu.side-right /template/ Border#PART_Surface">
    <Setter Property="RenderTransform" Value="translate(-8px, 0px) scale(0.95)" />
    <Setter Property="RenderTransformOrigin" Value="0%,0%" />
  </Style>

  <Style Selector="controls|CodexContextMenu.side-bottom /template/ Border#PART_Surface">
    <Setter Property="RenderTransform" Value="translate(0px, -8px) scale(0.95)" />
    <Setter Property="RenderTransformOrigin" Value="0%,0%" />
  </Style>

  <Style Selector="controls|CodexContextMenu.context-menu-open /template/ Border#PART_Surface">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(1)" />
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="6,6" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.PopoverForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusSm}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <ThicknessTransition Property="Padding" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="MenuItem">
        <Panel>
          <Border x:Name="PART_ItemRoot"
                  MinHeight="{TemplateBinding MinHeight}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransform="none">
            <Grid x:Name="PART_ItemGrid"
                  ColumnDefinitions="22,*,Auto,16">
              <Grid x:Name="PART_Indicator"
                    Grid.Column="0"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <PathIcon x:Name="PART_Check"
                          Width="13"
                          Height="13"
                          Foreground="{TemplateBinding Foreground}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Opacity="0"
                          RenderTransform="scale(0.82)"
                          Data="M4 10L8 14L16 5L17.5 6.5L8 17L2.5 11.5Z" />
                <PathIcon x:Name="PART_Radio"
                          Width="8"
                          Height="8"
                          Foreground="{TemplateBinding Foreground}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Opacity="0"
                          RenderTransform="scale(0.82)"
                          Data="M8 2C4.686 2 2 4.686 2 8C2 11.314 4.686 14 8 14C11.314 14 14 11.314 14 8C14 4.686 11.314 2 8 2Z" />
              </Grid>

              <ContentPresenter x:Name="PART_Icon"
                                Grid.Column="0"
                                Content="{TemplateBinding Icon}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

              <ContentPresenter x:Name="PART_Content"
                                Grid.Column="1"
                                Margin="4,0"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />

              <TextBlock x:Name="PART_Shortcut"
                         Grid.Column="2"
                         Text="{TemplateBinding InputGesture}"
                         FontSize="{DynamicResource CodexSwitch.FontSizeSm}"
                         Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                         VerticalAlignment="Center" />

              <PathIcon x:Name="PART_SubMenuArrow"
                        Grid.Column="3"
                        Width="13"
                        Height="13"
                        Margin="8,0,0,0"
                        Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Opacity="0"
                        RenderTransform="none"
                        Data="M5 3L9 7L5 11L3.8 9.8L6.6 7L3.8 4.2Z" />
            </Grid>
          </Border>

          <Popup x:Name="PART_Popup"
                 WindowManagerAddShadowHint="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                 PlacementTarget="PART_ItemRoot"
                 Placement="RightEdgeAlignedTop"
                 IsLightDismissEnabled="False"
                 InheritsTransform="True">
            <Border x:Name="PART_SubMenuSurface"
                    MinWidth="128"
                    MaxHeight="320"
                    Margin="4,0,0,0"
                    Padding="4"
                    Background="{DynamicResource CodexSwitch.PopoverBrush}"
                    BorderBrush="{DynamicResource CodexSwitch.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CodexSwitch.RadiusMd}"
                    Opacity="0"
                    RenderTransform="translate(-8px, 0px) scale(0.95)"
                    RenderTransformOrigin="0%,0%">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            IsScrollChainingEnabled="False">
                <ItemsPresenter x:Name="PART_SubMenuItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem">
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexContextMenuItem">
        <Panel>
          <Border x:Name="PART_ItemRoot"
                  MinHeight="{TemplateBinding MinHeight}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransform="none">
            <Grid x:Name="PART_ItemGrid"
                  ColumnDefinitions="22,*,Auto,16">
              <Grid x:Name="PART_Indicator"
                    Grid.Column="0"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <PathIcon x:Name="PART_Check"
                          Width="13"
                          Height="13"
                          Foreground="{TemplateBinding Foreground}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Opacity="0"
                          RenderTransform="scale(0.82)"
                          Data="M4 10L8 14L16 5L17.5 6.5L8 17L2.5 11.5Z" />
                <PathIcon x:Name="PART_Radio"
                          Width="8"
                          Height="8"
                          Foreground="{TemplateBinding Foreground}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Opacity="0"
                          RenderTransform="scale(0.82)"
                          Data="M8 2C4.686 2 2 4.686 2 8C2 11.314 4.686 14 8 14C11.314 14 14 11.314 14 8C14 4.686 11.314 2 8 2Z" />
              </Grid>

              <ContentPresenter x:Name="PART_Icon"
                                Grid.Column="0"
                                Content="{TemplateBinding Icon}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

              <ContentPresenter x:Name="PART_Content"
                                Grid.Column="1"
                                Margin="4,0"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />

              <TextBlock x:Name="PART_Shortcut"
                         Grid.Column="2"
                         Text="{TemplateBinding Shortcut}"
                         IsVisible="{TemplateBinding HasShortcut}"
                         FontSize="{DynamicResource CodexSwitch.FontSizeSm}"
                         Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                         VerticalAlignment="Center" />

              <PathIcon x:Name="PART_SubMenuArrow"
                        Grid.Column="3"
                        Width="13"
                        Height="13"
                        Margin="8,0,0,0"
                        Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Opacity="0"
                        RenderTransform="none"
                        Data="M5 3L9 7L5 11L3.8 9.8L6.6 7L3.8 4.2Z" />
            </Grid>
          </Border>

          <Popup x:Name="PART_Popup"
                 WindowManagerAddShadowHint="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                 PlacementTarget="PART_ItemRoot"
                 Placement="{TemplateBinding SubMenuPlacement}"
                 IsLightDismissEnabled="False"
                 InheritsTransform="True">
            <Border x:Name="PART_SubMenuSurface"
                    MinWidth="128"
                    MaxHeight="320"
                    Margin="4,0,0,0"
                    Padding="4"
                    Background="{DynamicResource CodexSwitch.PopoverBrush}"
                    BorderBrush="{DynamicResource CodexSwitch.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CodexSwitch.RadiusMd}"
                    Opacity="0"
                    RenderTransform="translate(-8px, 0px) scale(0.95)"
                    RenderTransformOrigin="0%,0%">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            IsScrollChainingEnabled="False">
                <ItemsPresenter x:Name="PART_SubMenuItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem /template/ Border#PART_ItemRoot">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem /template/ PathIcon#PART_Check, controls|CodexContextMenu MenuItem /template/ PathIcon#PART_Radio, controls|CodexContextMenu MenuItem /template/ PathIcon#PART_SubMenuArrow">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.AccentForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem:pointerover /template/ Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem:pressed /template/ Border#PART_ItemRoot">
    <Setter Property="RenderTransform" Value="scale(0.985)" />
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem:focus /template/ Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.RingBrush}" />
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.AccentForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem:selected /template/ Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem:open /template/ Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem:open /template/ PathIcon#PART_SubMenuArrow">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1.08)" />
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem:checked /template/ PathIcon#PART_Check">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.is-radio:checked /template/ PathIcon#PART_Check">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.is-radio:checked /template/ PathIcon#PART_Radio">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.active">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.AccentForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.active /template/ Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BorderBrush}" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.inset /template/ Border#PART_ItemRoot">
    <Setter Property="Padding" Value="30,6,8,6" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.has-submenu /template/ PathIcon#PART_SubMenuArrow">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.submenu-side-top /template/ Popup#PART_Popup">
    <Setter Property="Placement" Value="TopEdgeAlignedLeft" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.submenu-side-top /template/ Border#PART_SubMenuSurface">
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="RenderTransform" Value="translate(0px, 8px) scale(0.95)" />
    <Setter Property="RenderTransformOrigin" Value="0%,100%" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.submenu-side-left /template/ Popup#PART_Popup">
    <Setter Property="Placement" Value="LeftEdgeAlignedTop" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.submenu-side-left /template/ Border#PART_SubMenuSurface">
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="RenderTransform" Value="translate(8px, 0px) scale(0.95)" />
    <Setter Property="RenderTransformOrigin" Value="100%,0%" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.submenu-side-right /template/ Popup#PART_Popup">
    <Setter Property="Placement" Value="RightEdgeAlignedTop" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.submenu-side-right /template/ Border#PART_SubMenuSurface">
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="RenderTransform" Value="translate(-8px, 0px) scale(0.95)" />
    <Setter Property="RenderTransformOrigin" Value="0%,0%" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.submenu-side-bottom /template/ Popup#PART_Popup">
    <Setter Property="Placement" Value="BottomEdgeAlignedLeft" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.submenu-side-bottom /template/ Border#PART_SubMenuSurface">
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="RenderTransform" Value="translate(0px, -8px) scale(0.95)" />
    <Setter Property="RenderTransformOrigin" Value="0%,0%" />
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuItem.submenu-open /template/ Border#PART_SubMenuSurface">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(1)" />
  </Style>

  <Style Selector="controls|CodexContextMenu MenuItem:disabled">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>

  <Style Selector="controls|CodexContextMenu.size-sm MenuItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
  </Style>

  <Style Selector="controls|CodexContextMenu.size-lg MenuItem">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeLg}" />
  </Style>

  <Style Selector="controls|CodexContextMenu.size-icon MenuItem">
    <Setter Property="MinWidth" Value="{DynamicResource CodexSwitch.ControlHeightMd}" />
    <Setter Property="MinHeight" Value="{DynamicResource CodexSwitch.ControlHeightMd}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="controls|CodexContextMenu Separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="-4,4" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.BorderBrush}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Separator">
        <Border Height="{TemplateBinding Height}"
                Margin="{TemplateBinding Margin}"
                Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexContextMenu controls|CodexContextMenuSeparator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="-4,4" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.BorderBrush}" />
  </Style>

  <Style Selector="controls|CodexContextMenuLabel">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <ThicknessTransition Property="Padding" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexContextMenuLabel">
        <ContentPresenter x:Name="PART_LabelContent"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexContextMenuLabel.inset">
    <Setter Property="Padding" Value="30,6,8,6" />
  </Style>

  <Style Selector="controls|CodexContextMenuShortcut">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexContextMenuShortcut">
        <ContentPresenter x:Name="PART_ShortcutContent"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexContextMenuGroup">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexContextMenuGroup">
        <StackPanel x:Name="PART_Group"
                    Margin="{TemplateBinding Margin}">
          <ContentPresenter x:Name="PART_GroupHeader"
                            Content="{TemplateBinding Header}"
                            IsVisible="{TemplateBinding HasHeader}"
                            Margin="8,6"
                            FontSize="{DynamicResource CodexSwitch.FontSizeMd}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource CodexSwitch.ForegroundBrush}" />
          <ItemsPresenter x:Name="PART_GroupItems" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
