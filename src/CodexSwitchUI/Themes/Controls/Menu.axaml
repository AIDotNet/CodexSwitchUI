<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexMenu">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.PopoverForegroundBrush}" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.PopoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusLg}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="MinWidth" Value="180" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexMenu">
        <Border x:Name="PART_Surface"
                MinWidth="{TemplateBinding MinWidth}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter x:Name="PART_ItemsPresenter" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexMenu.loading">
    <Setter Property="Opacity" Value="0.84" />
  </Style>

  <Style Selector="controls|CodexMenu.side-nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="controls|CodexMenu.side-nav /template/ Border#PART_Surface">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="controls|CodexMenu MenuItem">
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeMd}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.PopoverForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusSm}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <ThicknessTransition Property="Padding" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="MenuItem">
        <Panel>
          <Border x:Name="PART_ItemRoot"
                  MinHeight="{TemplateBinding MinHeight}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransform="none">
            <Grid ColumnDefinitions="18,*,Auto,16">
              <Grid x:Name="PART_Indicator"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <PathIcon x:Name="PART_Check"
                          Width="13"
                          Height="13"
                          Foreground="{TemplateBinding Foreground}"
                          Opacity="0"
                          RenderTransform="scale(0.82)"
                          Data="M4 10L8 14L16 5L17.5 6.5L8 17L2.5 11.5Z" />
              </Grid>

              <ContentPresenter x:Name="PART_Icon"
                                Grid.Column="0"
                                Content="{TemplateBinding Icon}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />

              <ContentPresenter x:Name="PART_Content"
                                Grid.Column="1"
                                Margin="8,0"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />

              <TextBlock x:Name="PART_Shortcut"
                         Grid.Column="2"
                         Text="{TemplateBinding InputGesture}"
                         FontSize="{DynamicResource CodexSwitch.FontSizeSm}"
                         Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                         VerticalAlignment="Center" />

              <PathIcon x:Name="PART_SubMenuArrow"
                        Grid.Column="3"
                        Width="12"
                        Height="12"
                        Margin="8,0,0,0"
                        Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Opacity="0"
                        RenderTransform="none"
                        Data="M5 3L9 7L5 11L3.8 9.8L6.6 7L3.8 4.2Z" />
            </Grid>
          </Border>

          <Popup x:Name="PART_Popup"
                 WindowManagerAddShadowHint="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                 PlacementTarget="PART_ItemRoot"
                 Placement="RightEdgeAlignedTop"
                 IsLightDismissEnabled="False"
                 InheritsTransform="True">
            <Border x:Name="PART_SubMenuSurface"
                    MinWidth="184"
                    Margin="4,0,0,0"
                    Padding="4"
                    Background="{DynamicResource CodexSwitch.PopoverBrush}"
                    BorderBrush="{DynamicResource CodexSwitch.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CodexSwitch.RadiusLg}"
                    Opacity="0"
                    RenderTransform="scale(0.98)">
              <ItemsPresenter x:Name="PART_SubMenuItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}" />
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:top /template/ Panel Popup#PART_Popup">
    <Setter Property="Placement" Value="BottomEdgeAlignedLeft" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:top /template/ Panel Popup#PART_Popup Border#PART_SubMenuSurface">
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:open /template/ Panel Popup#PART_Popup Border#PART_SubMenuSurface">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem /template/ Panel Border#PART_ItemRoot, controls|CodexMenu controls|CodexMenuItem /template/ Panel Popup#PART_Popup Border#PART_SubMenuSurface">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem /template/ Panel Border#PART_ItemRoot PathIcon#PART_Check, controls|CodexMenu controls|CodexMenuItem /template/ Panel Border#PART_ItemRoot PathIcon#PART_SubMenuArrow">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource CodexSwitch.MotionDurationFast}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.AccentForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:pointerover /template/ Panel Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:pressed">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.AccentForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:pressed /template/ Panel Border#PART_ItemRoot">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:focus-visible">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.AccentForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:focus-visible /template/ Panel Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.AccentForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:selected /template/ Panel Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:open /template/ Panel Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:open /template/ Panel Border#PART_ItemRoot PathIcon#PART_SubMenuArrow">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1.08)" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:checked /template/ Panel Border#PART_ItemRoot PathIcon#PART_Check">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="RenderTransform" Value="scale(1)" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem.active">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.AccentForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem.active /template/ Panel Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="controls|CodexMenu.side-nav controls|CodexMenuItem">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CodexSwitch.RadiusSm}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexMenu.side-nav controls|CodexMenuItem /template/ Panel Border#PART_ItemRoot">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="controls|CodexMenu.side-nav controls|CodexMenuItem:pointerover /template/ Panel Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
  </Style>

  <Style Selector="controls|CodexMenu.side-nav controls|CodexMenuItem:pressed /template/ Panel Border#PART_ItemRoot">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="controls|CodexMenu.side-nav controls|CodexMenuItem:focus-visible /template/ Panel Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="controls|CodexMenu.side-nav controls|CodexMenuItem.active">
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.AccentForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexMenu.side-nav controls|CodexMenuItem.active /template/ Panel Border#PART_ItemRoot">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.AccentBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="controls|CodexMenu.side-nav controls|CodexMenuGroup">
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="controls|CodexMenu.side-nav controls|CodexMenuGroup /template/ ContentPresenter#PART_GroupHeader">
    <Setter Property="Margin" Value="10,6,10,5" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem.has-submenu /template/ Panel Border#PART_ItemRoot PathIcon#PART_SubMenuArrow">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem">
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexMenuItem">
        <Panel>
          <Border x:Name="PART_ItemRoot"
                  MinHeight="{TemplateBinding MinHeight}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}"
                  RenderTransform="none">
            <Grid ColumnDefinitions="18,*,Auto,16">
              <PathIcon x:Name="PART_Check"
                        Grid.Column="0"
                        Width="13"
                        Height="13"
                        Foreground="{TemplateBinding Foreground}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0"
                        RenderTransform="scale(0.82)"
                        Data="M4 10L8 14L16 5L17.5 6.5L8 17L2.5 11.5Z" />
              <ContentPresenter x:Name="PART_Icon"
                                Grid.Column="0"
                                Content="{TemplateBinding Icon}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
              <ContentPresenter x:Name="PART_Content"
                                Grid.Column="1"
                                Margin="8,0"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
              <TextBlock x:Name="PART_Shortcut"
                         Grid.Column="2"
                         Text="{TemplateBinding Shortcut}"
                         IsVisible="{TemplateBinding HasShortcut}"
                         FontSize="{DynamicResource CodexSwitch.FontSizeSm}"
                         Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                         VerticalAlignment="Center" />
              <PathIcon x:Name="PART_SubMenuArrow"
                        Grid.Column="3"
                        Width="12"
                        Height="12"
                        Margin="8,0,0,0"
                        Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Opacity="0"
                        RenderTransform="none"
                        Data="M5 3L9 7L5 11L3.8 9.8L6.6 7L3.8 4.2Z" />
            </Grid>
          </Border>

          <Popup x:Name="PART_Popup"
                 WindowManagerAddShadowHint="False"
                 IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                 PlacementTarget="PART_ItemRoot"
                 Placement="RightEdgeAlignedTop"
                 IsLightDismissEnabled="False"
                 InheritsTransform="True">
            <Border x:Name="PART_SubMenuSurface"
                    MinWidth="184"
                    Margin="4,0,0,0"
                    Padding="4"
                    Background="{DynamicResource CodexSwitch.PopoverBrush}"
                    BorderBrush="{DynamicResource CodexSwitch.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CodexSwitch.RadiusLg}"
                    Opacity="0"
                    RenderTransform="scale(0.98)">
              <ItemsPresenter x:Name="PART_SubMenuItemsPresenter"
                              ItemsPanel="{TemplateBinding ItemsPanel}" />
            </Border>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuItem:disabled">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>

  <Style Selector="controls|CodexMenu.size-sm controls|CodexMenuItem">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
  </Style>

  <Style Selector="controls|CodexMenu.size-lg controls|CodexMenuItem">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeLg}" />
  </Style>

  <Style Selector="controls|CodexMenu.size-icon controls|CodexMenuItem">
    <Setter Property="MinWidth" Value="{DynamicResource CodexSwitch.ControlHeightMd}" />
    <Setter Property="MinHeight" Value="{DynamicResource CodexSwitch.ControlHeightMd}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="controls|CodexMenu Separator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="-4,4" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.BorderBrush}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="Separator">
        <Border Height="{TemplateBinding Height}"
                Margin="{TemplateBinding Margin}"
                Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexMenu controls|CodexMenuSeparator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="-4,4" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.BorderBrush}" />
  </Style>

  <Style Selector="controls|CodexMenuGroup">
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Spacing="2" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexMenuGroup">
        <StackPanel x:Name="PART_Group"
                    Margin="{TemplateBinding Margin}">
          <ContentPresenter x:Name="PART_GroupHeader"
                            Content="{TemplateBinding Header}"
                            Margin="8,6,8,4"
                            FontSize="{DynamicResource CodexSwitch.FontSizeSm}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
          <ItemsPresenter x:Name="PART_GroupItems"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexMenuEmpty">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexMenuEmpty">
        <Border x:Name="PART_Empty"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexMenuLoading">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexMenuLoading">
        <Border x:Name="PART_Loading"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
</Styles>
