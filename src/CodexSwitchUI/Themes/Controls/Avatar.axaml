<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexAvatar">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.MutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BackgroundBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexAvatar">
        <Grid x:Name="PART_Root"
              Width="{TemplateBinding Width}"
              Height="{TemplateBinding Height}">
          <Border x:Name="PART_Surface"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <Grid>
              <Image x:Name="PART_Image"
                     Source="{TemplateBinding Source}"
                     Stretch="UniformToFill"
                     IsVisible="{TemplateBinding HasImage}"
                     Opacity="1" />
              <TextBlock x:Name="PART_Fallback"
                         Text="{TemplateBinding Fallback}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{DynamicResource CodexSwitch.FontSizeSm}"
                         FontWeight="SemiBold"
                         Foreground="{TemplateBinding Foreground}"
                         IsVisible="{TemplateBinding IsFallbackVisible}"
                         Opacity="1" />
            </Grid>
          </Border>
          <Border x:Name="PART_Status"
                  Width="11"
                  Height="11"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Background="{DynamicResource CodexSwitch.SuccessBrush}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  IsVisible="{TemplateBinding IsStatusVisible}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexAvatar /template/ Border#PART_Surface, controls|CodexAvatar /template/ Border#PART_Status">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexAvatar /template/ Image#PART_Image, controls|CodexAvatar /template/ TextBlock#PART_Fallback">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexAvatar.loading /template/ Image#PART_Image">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="controls|CodexAvatar.loaded /template/ Image#PART_Image">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexAvatar.error /template/ TextBlock#PART_Fallback">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexAvatar.fallback-visible /template/ TextBlock#PART_Fallback">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="controls|CodexAvatar.fallback-delayed /template/ TextBlock#PART_Fallback">
    <Setter Property="Opacity" Value="0.96" />
  </Style>

  <Style Selector="controls|CodexAvatar:disabled">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>

  <Style Selector="controls|CodexAvatar.size-sm">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <Style Selector="controls|CodexAvatar.size-sm /template/ Border#PART_Status">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style Selector="controls|CodexAvatar.size-lg">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="24" />
  </Style>

  <Style Selector="controls|CodexAvatar.size-lg /template/ Border#PART_Status">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <Style Selector="controls|CodexAvatar.size-icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="controls|CodexAvatar.variant-default">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.PrimaryForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.variant-secondary">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.SecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.SecondaryForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.variant-outline">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.BackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.variant-destructive">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.DestructiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.DestructiveForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.variant-success">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.SuccessBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.SuccessForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.variant-warning">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.WarningBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.WarningForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.status-default /template/ Border#PART_Status, controls|CodexAvatar.status-secondary /template/ Border#PART_Status">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.status-destructive /template/ Border#PART_Status">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.DestructiveBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.status-success /template/ Border#PART_Status">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.SuccessBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.status-warning /template/ Border#PART_Status">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.WarningBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatarGroup">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexAvatarGroup:disabled">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>

  <Style Selector="controls|CodexAvatarGroup.size-sm">
    <Setter Property="MinHeight" Value="32" />
  </Style>

  <Style Selector="controls|CodexAvatarGroup.size-lg">
    <Setter Property="MinHeight" Value="48" />
  </Style>

  <Style Selector="controls|CodexAvatarGroup.size-icon">
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="controls|CodexAvatar.avatar-group-item /template/ Border#PART_Surface">
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BackgroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatarGroupCount">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.MutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BackgroundBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="FontFamily" Value="{DynamicResource CodexSwitch.FontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource CodexSwitch.FontSizeSm}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="Foreground" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexAvatarGroupCount">
        <Border x:Name="PART_CountSurface"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter x:Name="PART_CountContent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexAvatarGroupCount /template/ Border#PART_CountSurface">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
        <BrushTransition Property="BorderBrush" Duration="{DynamicResource CodexSwitch.MotionDurationDefault}" Easing="{DynamicResource CodexSwitch.MotionEaseOut}" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexAvatarGroupCount.size-sm">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <Style Selector="controls|CodexAvatarGroupCount.size-lg">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="24" />
  </Style>

  <Style Selector="controls|CodexAvatarGroupCount.size-icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
</Styles>
