<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CodexSwitchUI.Controls">
  <Style Selector="controls|CodexAvatar">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.MutedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CodexSwitch.BackgroundBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CodexAvatar">
        <Grid x:Name="PART_Root"
              Width="{TemplateBinding Width}"
              Height="{TemplateBinding Height}">
          <Border x:Name="PART_Surface"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  ClipToBounds="True">
            <Grid>
              <Image x:Name="PART_Image"
                     Source="{TemplateBinding Source}"
                     Stretch="UniformToFill"
                     IsVisible="{TemplateBinding HasImage}" />
              <TextBlock x:Name="PART_Fallback"
                         Text="{TemplateBinding Fallback}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{DynamicResource CodexSwitch.FontSizeSm}"
                         FontWeight="SemiBold"
                         Foreground="{TemplateBinding Foreground}"
                         IsVisible="{TemplateBinding HasFallback}" />
            </Grid>
          </Border>
          <Border x:Name="PART_Status"
                  Width="11"
                  Height="11"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Background="{DynamicResource CodexSwitch.SuccessBrush}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="6"
                  IsVisible="{TemplateBinding IsStatusVisible}" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|CodexAvatar /template/ Border#PART_Surface, controls|CodexAvatar /template/ Border#PART_Status">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="controls|CodexAvatar:disabled">
    <Setter Property="Opacity" Value="{DynamicResource CodexSwitch.DisabledOpacity}" />
  </Style>

  <Style Selector="controls|CodexAvatar.size-sm">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <Style Selector="controls|CodexAvatar.size-sm /template/ Border#PART_Status">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <Style Selector="controls|CodexAvatar.size-lg">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="24" />
  </Style>

  <Style Selector="controls|CodexAvatar.size-lg /template/ Border#PART_Status">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <Style Selector="controls|CodexAvatar.size-icon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="controls|CodexAvatar.variant-default">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.PrimaryForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.variant-secondary">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.SecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.SecondaryForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.variant-outline">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.BackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.ForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.variant-destructive">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.DestructiveBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.DestructiveForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.variant-success">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.SuccessBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.SuccessForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.variant-warning">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.WarningBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource CodexSwitch.WarningForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.status-default /template/ Border#PART_Status, controls|CodexAvatar.status-secondary /template/ Border#PART_Status">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.MutedForegroundBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.status-destructive /template/ Border#PART_Status">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.DestructiveBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.status-success /template/ Border#PART_Status">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.SuccessBrush}" />
  </Style>

  <Style Selector="controls|CodexAvatar.status-warning /template/ Border#PART_Status">
    <Setter Property="Background" Value="{DynamicResource CodexSwitch.WarningBrush}" />
  </Style>
</Styles>
