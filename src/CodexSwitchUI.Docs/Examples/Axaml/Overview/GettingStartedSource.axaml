<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      ColumnDefinitions="*,*,*"
      ColumnSpacing="14">
  <controls:CodexField Label="AXAML file"
                       Description="One sample path per case.">
    <primitives:CodexText Role="Code"
                          Text="Examples/Axaml/Forms/Button.axaml" />
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Code block"
                       Description="Selectable text and copy command.">
    <StackPanel Spacing="8">
      <controls:CodexBadge Content="Menlo"
                           Variant="Secondary" />
      <controls:CodexBadge Content="line numbers"
                           Variant="Outline" />
      <controls:CodexBadge Content="copy"
                           Variant="Success" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Column="2"
                       Label="Render tests"
                       Description="Lifecycle coverage catches detach and transition crashes.">
    <StackPanel Spacing="8">
      <primitives:CodexText Role="Code"
                            Text="DocsMultiCaseExamples" />
      <primitives:CodexText Role="Code"
                            Text="DocsVisualFingerprints" />
    </StackPanel>
  </controls:CodexField>
</Grid>
