<controls:CodexAlertDialog xmlns="https://github.com/avaloniaui"
                           xmlns:controls="using:CodexSwitchUI.Controls"
                           IsOpen="True"
                           Title="Remove saved credentials?"
                           Description="Header, media, body content, cancel, and action slots are all component-owned."
                           Media="!"
                           ActionContent="Remove credentials"
                           ActionVariant="Destructive">
  <StackPanel Spacing="10">
    <controls:CodexAlert Icon="!"
                         Title="Provider authentication will fail."
                         Description="You can add a new key later from provider settings."
                         Variant="Warning" />
    <controls:CodexField Label="Audit note">
      <controls:CodexTextarea MinHeight="76"
                              PlaceholderText="Optional note" />
    </controls:CodexField>
  </StackPanel>
</controls:CodexAlertDialog>
