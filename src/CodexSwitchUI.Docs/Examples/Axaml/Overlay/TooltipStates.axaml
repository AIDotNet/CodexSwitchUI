<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="14"
      RowSpacing="14">
  <controls:CodexTooltip Content="Top tooltip"
                         Placement="Top"
                         IsOpen="True"
                         IsArrowVisible="True" />
  <controls:CodexTooltip Grid.Column="1"
                         Content="Right tooltip"
                         Placement="Right"
                         Size="Small"
                         IsOpen="True"
                         IsArrowVisible="True" />
  <controls:CodexTooltip Grid.Row="1"
                         Content="Bottom tooltip"
                         Placement="Bottom"
                         Size="Large"
                         IsOpen="True" />
  <controls:CodexTooltip Grid.Row="1"
                         Grid.Column="1"
                         Content="Closed tooltip"
                         Placement="Left"
                         IsOpen="False"
                         IsArrowVisible="True" />
</Grid>
