<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="14"
      RowSpacing="14">
  <controls:CodexField Label="Determinate transition"
                       Description="Value changes animate the indicator width through the shared motion token.">
    <controls:CodexProgress Minimum="0"
                            Maximum="100"
                            Value="36"
                            ShowProgressText="True"
                            MinWidth="360" />
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Indeterminate loop"
                       Description="The loading segment moves across the track while work is unknown.">
    <controls:CodexProgress IsIndeterminate="True"
                            Variant="Success"
                            MinWidth="360" />
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Reduced motion"
                       Description="Zero duration keeps the indeterminate segment static.">
    <controls:CodexProgress IsIndeterminate="True"
                            IndeterminateAnimationDuration="0:0:0"
                            Variant="Warning"
                            Size="Large"
                            MinWidth="360" />
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Disabled guard"
                       Description="Disabled progress retains value while using shared disabled opacity.">
    <controls:CodexProgress Minimum="0"
                            Maximum="100"
                            Value="68"
                            IsEnabled="False"
                            MinWidth="360" />
  </controls:CodexField>
</Grid>
