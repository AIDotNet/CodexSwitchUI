<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      ColumnDefinitions="*,*"
      ColumnSpacing="16">
  <controls:CodexField Label="Layout controls"
                       Description="Stacking and overlap update the same measured group without rebuilding children.">
    <controls:CodexField.Content>
      <StackPanel Spacing="12">
        <primitives:CodexText Role="Muted"
                              Text="Stacked group: overlap=12; visible members=4."
                              TextWrapping="Wrap" />
        <controls:CodexAvatarGroup Size="Medium"
                                   Overlap="12">
          <controls:CodexAvatar Fallback="CN"
                                ImagePath="avares://CodexSwitchUI.Docs/Assets/icons/openai.png"
                                IsStatusVisible="True" />
          <controls:CodexAvatar Fallback="LR"
                                ImagePath="avares://CodexSwitchUI.Docs/Assets/icons/claude.png"
                                Variant="Secondary" />
          <controls:CodexAvatar Fallback="QA"
                                Variant="Warning"
                                StatusVariant="Warning"
                                IsStatusVisible="True" />
          <controls:CodexAvatarGroupCount Count="5" />
        </controls:CodexAvatarGroup>
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <controls:CodexButton Content="Toggle stacking"
                                Size="Small"
                                Variant="Secondary" />
          <controls:CodexButton Content="Cycle overlap"
                                Size="Small"
                                Variant="Secondary" />
          <controls:CodexButton Content="Toggle member"
                                Size="Small"
                                Variant="Secondary" />
        </StackPanel>
      </StackPanel>
    </controls:CodexField.Content>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Disabled host"
                       Description="Host controls can disable the whole group without removing avatar identity.">
    <controls:CodexField.Content>
      <controls:CodexButton Content="Assign reviewers"
                            IsEnabled="False">
        <controls:CodexButton.LeadingIcon>
          <controls:CodexAvatarGroup Size="Small"
                                     Overlap="8">
            <controls:CodexAvatar Fallback="CN"
                                  ImagePath="avares://CodexSwitchUI.Docs/Assets/icons/openai.png"
                                  IsStatusVisible="True" />
            <controls:CodexAvatar Fallback="LR"
                                  ImagePath="avares://CodexSwitchUI.Docs/Assets/icons/claude.png"
                                  Variant="Secondary" />
            <controls:CodexAvatar Fallback="ER"
                                  Variant="Outline" />
            <controls:CodexAvatarGroupCount Count="3" />
          </controls:CodexAvatarGroup>
        </controls:CodexButton.LeadingIcon>
      </controls:CodexButton>
    </controls:CodexField.Content>
  </controls:CodexField>
</Grid>
