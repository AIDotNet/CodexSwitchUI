<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="14"
      RowSpacing="14">
  <controls:CodexEmptyState Title="Default"
                            Description="No matching sessions."
                            Action="Refresh"
                            MinHeight="180" />
  <controls:CodexEmptyState Grid.Column="1"
                            Title="Success"
                            Description="All providers are healthy."
                            Variant="Success"
                            Action="View"
                            MinHeight="180" />
  <controls:CodexEmptyState Grid.Row="1"
                            Title="Warning"
                            Description="Fallback is currently active."
                            Variant="Warning"
                            Action="Inspect"
                            SecondaryAction="Dismiss"
                            MinHeight="180" />
  <controls:CodexEmptyState Grid.Row="1"
                            Grid.Column="1"
                            Title="Loading"
                            Description="Actions are suppressed while refreshing."
                            IsLoading="True"
                            Action="Refresh"
                            MinHeight="180" />
</Grid>
