<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      ColumnSpacing="14">
  <controls:CodexField Label="Expanded rich viewport"
                       Description="The viewport owns placement, offset, visible count, animated host rows, and toast rich-color styling.">
    <Border MinHeight="250">
      <controls:CodexSonner Position="TopRight"
                            RichColors="True"
                            Expand="True"
                            VisibleToasts="3"
                            CloseButton="True"
                            Offset="0" />
    </Border>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Compact close policy"
                       Description="Compact mode renders one host row while close-hidden styling remains scoped to CodexToast close chrome.">
    <Border MinHeight="250">
      <controls:CodexSonner Position="BottomLeft"
                            RichColors="False"
                            Expand="False"
                            VisibleToasts="3"
                            CloseButton="False"
                            Offset="0" />
    </Border>
  </controls:CodexField>
</Grid>
