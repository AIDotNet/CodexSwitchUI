<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      RowDefinitions="Auto,Auto,Auto"
      RowSpacing="12">
  <primitives:CodexText Role="Muted"
                        Text="Sonner viewport is empty by default. Trigger a toast to mount host rows." />

  <StackPanel Grid.Row="1"
              Orientation="Horizontal"
              Spacing="8">
    <controls:CodexButton Content="Success"
                          Size="Small"
                          Variant="Secondary" />
    <controls:CodexButton Content="Warning"
                          Size="Small"
                          Variant="Ghost" />
    <controls:CodexButton Content="Loading"
                          Size="Small"
                          Variant="Ghost" />
    <controls:CodexButton Content="Clear"
                          Size="Small"
                          Variant="Outline" />
  </StackPanel>

  <Grid Grid.Row="2"
        ColumnDefinitions="*,*"
        ColumnSpacing="14">
    <Border MinHeight="240">
      <controls:CodexSonner Position="TopRight"
                            RichColors="True"
                            Expand="True"
                            VisibleToasts="3"
                            CloseButton="True"
                            Offset="0" />
    </Border>

    <Border Grid.Column="1"
            MinHeight="240">
      <controls:CodexSonner Position="BottomLeft"
                            RichColors="False"
                            Expand="False"
                            VisibleToasts="2"
                            CloseButton="False"
                            Offset="0" />
    </Border>
  </Grid>
</Grid>
