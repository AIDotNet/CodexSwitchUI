<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Dismiss command path"
                       Description="Close button, Escape, and DismissCommand converge on one close callback.">
    <controls:CodexField.Content>
      <StackPanel Spacing="10">
        <primitives:CodexText Role="Muted"
                              Text="Toast is closed by default. Use the controls to open and dismiss it." />
        <controls:CodexToast IsOpen="False"
                             Icon="i"
                             Title="Provider switched"
                             Description="Close button, Escape, and DismissCommand close the same mounted surface."
                             CloseContent="Dismiss">
          <controls:CodexToast.Action>
            <controls:CodexButton Content="Undo"
                                  Size="Small"
                                  Variant="Secondary" />
          </controls:CodexToast.Action>
        </controls:CodexToast>
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <controls:CodexButton Content="Dismiss command"
                                Size="Small"
                                Variant="Secondary" />
          <controls:CodexButton Content="Show toast"
                                Size="Small"
                                Variant="Outline" />
        </StackPanel>
      </StackPanel>
    </controls:CodexField.Content>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Manual Escape policy"
                       Description="CloseOnEscape=false keeps keyboard dismissal under host control.">
    <controls:CodexField.Content>
      <StackPanel Spacing="10">
        <controls:CodexToast IsOpen="False"
                             Icon="!"
                             Title="Manual dismissal policy"
                             Description="Escape is ignored because host code owns this notification."
                             Variant="Warning"
                             CloseOnEscape="False"
                             CloseContent="Manual" />
        <controls:CodexButton Content="Toggle manual"
                              Size="Small"
                              Variant="Secondary" />
      </StackPanel>
    </controls:CodexField.Content>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Action without dismissal"
                       Description="The action slot can mutate content while the toast remains open.">
    <controls:CodexField.Content>
      <StackPanel Spacing="10">
        <controls:CodexToast IsOpen="False"
                             Icon="i"
                             Title="Usage refreshed"
                             Description="Action and close controls are independent slots."
                             CloseContent="Close">
          <controls:CodexToast.Action>
            <controls:CodexButton Content="View"
                                  Size="Small"
                                  Variant="Secondary" />
          </controls:CodexToast.Action>
        </controls:CodexToast>
        <controls:CodexButton Content="Show action toast"
                              Size="Small"
                              Variant="Secondary" />
      </StackPanel>
    </controls:CodexField.Content>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Closed exit state"
                       Description="Open and closed classes can be toggled without removing the toast from layout.">
    <controls:CodexField.Content>
      <StackPanel Spacing="10">
        <controls:CodexToast Title="Closed exit state"
                             Description="Closed class stays inspectable for exit motion verification."
                             Variant="Destructive"
                             IsOpen="False" />
        <controls:CodexButton Content="Toggle closed sample"
                              Size="Small"
                              Variant="Secondary" />
      </StackPanel>
    </controls:CodexField.Content>
  </controls:CodexField>
</Grid>
