<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      ColumnDefinitions="*,*"
      ColumnSpacing="16">
  <controls:CodexField Label="16:9 media"
                       Description="Width fit keeps the slot at video ratio while content stays clipped.">
    <controls:CodexAspectRatio Ratio="1.7777777778"
                               Width="360">
      <Border Background="{DynamicResource CodexSwitch.MutedBrush}">
        <Grid>
          <Border Width="6"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource CodexSwitch.PrimaryBrush}" />
          <StackPanel Margin="22,16,16,16"
                      Spacing="8"
                      VerticalAlignment="Bottom">
            <controls:CodexBadge Content="16:9"
                                 Variant="Secondary"
                                 HorizontalAlignment="Left" />
            <primitives:CodexText Text="Model routing"
                                  Role="Subtitle" />
            <primitives:CodexText Text="Media-sized dashboard panel"
                                  Role="Muted"
                                  TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </controls:CodexAspectRatio>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Portrait preview"
                       Description="Portrait ratios use the same content host and state classes.">
    <controls:CodexAspectRatio Ratio="0.5625"
                               Width="190">
      <Border Background="{DynamicResource CodexSwitch.MutedBrush}">
        <Grid>
          <Border Width="6"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource CodexSwitch.SuccessBrush}" />
          <StackPanel Margin="22,16,16,16"
                      Spacing="8"
                      VerticalAlignment="Bottom">
            <controls:CodexBadge Content="9:16"
                                 Variant="Secondary"
                                 HorizontalAlignment="Left" />
            <primitives:CodexText Text="Provider logo"
                                  Role="Subtitle" />
            <primitives:CodexText Text="Tall visual identity block"
                                  Role="Muted"
                                  TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </controls:CodexAspectRatio>
  </controls:CodexField>
</Grid>
