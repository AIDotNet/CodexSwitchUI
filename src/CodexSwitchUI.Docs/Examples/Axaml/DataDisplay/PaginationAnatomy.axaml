<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Action parts"
                       Description="First, previous, next, and last controls are CodexButton parts.">
    <controls:CodexPagination Page="6"
                              PageCount="18"
                              BoundaryCount="1"
                              SiblingCount="1" />
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Page item parts"
                       Description="Page buttons expose page-item, current, and ellipsis classes.">
    <controls:CodexPagination Page="9"
                              PageCount="42"
                              SiblingCount="1"
                              BoundaryCount="1" />
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Compact shell"
                       Description="Compact mode hides first/last and tightens spacing.">
    <controls:CodexPagination Page="3"
                              PageCount="8"
                              IsCompact="True"
                              ShowFirstLast="False"
                              Size="Small" />
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Loading guard"
                       Description="Loading keeps the current page visible and suppresses navigation.">
    <controls:CodexPagination Page="5"
                              PageCount="18"
                              IsLoading="True" />
  </controls:CodexField>
</Grid>
