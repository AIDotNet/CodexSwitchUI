<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      ColumnDefinitions="*,*"
      ColumnSpacing="16">
  <controls:CodexField Label="Ratio event path"
                       Description="Ratio, fit, and content mutations stay component-owned.">
    <StackPanel Spacing="10">
      <primitives:CodexText Text="RatioChanged: waiting for ratio input."
                            Role="Muted"
                            TextWrapping="Wrap" />
      <controls:CodexAspectRatio Ratio="1.7777777778"
                                 Width="360">
        <Border Background="{DynamicResource CodexSwitch.MutedBrush}">
          <Grid>
            <Border Width="6"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource CodexSwitch.PrimaryBrush}" />
            <StackPanel Margin="22,16,16,16"
                        Spacing="8"
                        VerticalAlignment="Bottom">
              <controls:CodexBadge Content="16:9"
                                   Variant="Secondary"
                                   HorizontalAlignment="Left" />
              <primitives:CodexText Text="Interactive media"
                                    Role="Subtitle" />
              <primitives:CodexText Text="Buttons in the live preview mutate this component."
                                    Role="Muted"
                                    TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
      </controls:CodexAspectRatio>
      <StackPanel Orientation="Horizontal"
                  Spacing="8">
        <controls:CodexButton Content="16:9"
                              Size="Small"
                              Variant="Secondary" />
        <controls:CodexButton Content="1:1"
                              Size="Small"
                              Variant="Secondary" />
        <controls:CodexButton Content="9:16"
                              Size="Small"
                              Variant="Secondary" />
        <controls:CodexButton Content="Invalid"
                              Size="Small"
                              Variant="Ghost" />
      </StackPanel>
      <StackPanel Orientation="Horizontal"
                  Spacing="8">
        <controls:CodexButton Content="Fit: width"
                              Size="Small"
                              Variant="Secondary" />
        <controls:CodexButton Content="Hide content"
                              Size="Small"
                              Variant="Secondary" />
      </StackPanel>
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Hover and empty guard"
                       Description="Pointer hover animates border state; invalid ratios normalize to a square placeholder.">
    <controls:CodexAspectRatio Ratio="-1"
                               Width="230"
                               Size="Small" />
  </controls:CodexField>
</Grid>
