<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CodexSwitchUI.Controls"
      x:CompileBindings="False"
      ColumnDefinitions="*,*"
      ColumnSpacing="16">
  <controls:CodexField Label="Slice anatomy"
                       Description="Slices, center label/value, legend text, and active tooltip are drawn by the chart surface.">
    <controls:CodexUsagePieChart Width="420"
                                 Height="236"
                                 TotalLabel="Tokens"
                                 TotalValue="89.4K"
                                 ActiveIndex="1"
                                 AnimationDuration="0:0:0"
                                 ItemsSource="{Binding UsageBurstItems}" />
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Motion and fallback anatomy"
                       Description="AnimationDuration controls refresh motion; empty and compact states stay chart-owned.">
    <StackPanel Spacing="12">
      <controls:CodexUsagePieChart Width="340"
                                   Height="178"
                                   IsCompact="True"
                                   TotalLabel="Requests"
                                   TotalValue="1.2K"
                                   AnimationDuration="0:0:0"
                                   ItemsSource="{Binding CompactUsageItems}" />
      <controls:CodexUsagePieChart Width="340"
                                   Height="150"
                                   TotalLabel="Tokens"
                                   TotalValue="0"
                                   ItemsSource="{Binding EmptyUsageItems}" />
    </StackPanel>
  </controls:CodexField>
</Grid>
