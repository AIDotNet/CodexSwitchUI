<echarts:CsUsageTrendChart xmlns="https://github.com/avaloniaui"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:echarts="using:CodexSwitchUI.ECharts.Controls"
                           x:CompileBindings="False"
                           Width="620"
                           Height="320"
                           Granularity="Hour"
                           ItemsSource="{Binding UsageTrendItems}" />
