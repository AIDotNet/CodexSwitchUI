<controls:CodexUsagePieChart xmlns="https://github.com/avaloniaui"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:controls="using:CodexSwitchUI.Controls"
                             x:CompileBindings="False"
                             Width="460"
                             Height="240"
                             TotalLabel="Tokens"
                             TotalValue="71.5K"
                             ItemsSource="{Binding UsageItems}" />
