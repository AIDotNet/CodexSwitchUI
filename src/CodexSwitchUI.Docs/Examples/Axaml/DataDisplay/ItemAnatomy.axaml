<controls:CodexItemGroup xmlns="https://github.com/avaloniaui"
                         xmlns:controls="using:CodexSwitchUI.Controls"
                         Variant="Outline"
                         IsInset="True">
  <controls:CodexItem Header="Route"
                      Title="OpenAI Responses"
                      Description="Header, media, title, description, content, actions, footer, and separator slots."
                      Footer="Updated 2 minutes ago"
                      IsInteractive="True">
    <controls:CodexItem.Media>
      <controls:CodexItemMedia Content="AI"
                               Variant="Success"
                               Size="Large" />
    </controls:CodexItem.Media>
    <controls:CodexItem.Content>
      <controls:CodexProgress Value="72"
                              Variant="Success" />
    </controls:CodexItem.Content>
    <controls:CodexItem.Actions>
      <StackPanel Orientation="Horizontal"
                  Spacing="8">
        <controls:CodexButton Content="Edit"
                              Size="Small"
                              Variant="Secondary" />
        <controls:CodexButton Content="Disable"
                              Size="Small"
                              Variant="Ghost" />
      </StackPanel>
    </controls:CodexItem.Actions>
  </controls:CodexItem>

  <controls:CodexItemSeparator />

  <controls:CodexItem Title="Composition primitives"
                      Description="Slot controls can be used directly when a page needs custom layout.">
    <controls:CodexItem.Content>
      <StackPanel Spacing="4">
        <controls:CodexItemTitle Content="Title primitive" />
        <controls:CodexItemDescription Content="Description primitive" />
        <controls:CodexItemFooter Content="Footer primitive" />
      </StackPanel>
    </controls:CodexItem.Content>
  </controls:CodexItem>
</controls:CodexItemGroup>
