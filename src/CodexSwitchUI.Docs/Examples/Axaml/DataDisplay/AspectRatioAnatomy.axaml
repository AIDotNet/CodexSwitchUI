<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      ColumnDefinitions="*,*"
      ColumnSpacing="16">
  <controls:CodexField Label="Content host"
                       Description="Root, viewport, and content host clip slotted content to the measured ratio.">
    <controls:CodexAspectRatio Ratio="1.3333333333"
                               Width="320">
      <Border Background="{DynamicResource CodexSwitch.MutedBrush}">
        <Grid>
          <Border Width="6"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource CodexSwitch.WarningBrush}" />
          <StackPanel Margin="22,16,16,16"
                      Spacing="8"
                      VerticalAlignment="Bottom">
            <controls:CodexBadge Content="4:3"
                                 Variant="Secondary"
                                 HorizontalAlignment="Left" />
            <primitives:CodexText Text="Clipped content"
                                  Role="Subtitle" />
            <primitives:CodexText Text="Root / viewport / content host"
                                  Role="Muted"
                                  TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </controls:CodexAspectRatio>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Contain fit"
                       Description="Contain mode respects an explicit bounding box without stretching the child.">
    <controls:CodexAspectRatio Ratio="1.7777777778"
                               FitMode="Contain"
                               Width="310"
                               Height="190"
                               Size="Large">
      <Border Background="{DynamicResource CodexSwitch.MutedBrush}">
        <Grid>
          <Border Width="6"
                  HorizontalAlignment="Left"
                  Background="{DynamicResource CodexSwitch.SecondaryBrush}" />
          <StackPanel Margin="22,16,16,16"
                      Spacing="8"
                      VerticalAlignment="Bottom">
            <controls:CodexBadge Content="contain"
                                 Variant="Secondary"
                                 HorizontalAlignment="Left" />
            <primitives:CodexText Text="Bounded frame"
                                  Role="Subtitle" />
            <primitives:CodexText Text="FitMode=Contain"
                                  Role="Muted"
                                  TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </controls:CodexAspectRatio>
  </controls:CodexField>
</Grid>
