<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      ColumnSpacing="16">
  <controls:CodexCard Title="Card slots"
                      Description="Header, title, description, content, and footer stay independently mounted.">
    <StackPanel Spacing="8">
      <controls:CodexBadge Content="PART_Content"
                           Variant="Secondary"
                           HorizontalAlignment="Left" />
      <TextBlock Text="Content can host metrics, progress, lists, or any Avalonia control."
                 TextWrapping="Wrap"
                 Opacity="0.72" />
    </StackPanel>
    <controls:CodexCard.Footer>
      <StackPanel Orientation="Horizontal"
                  Spacing="8">
        <controls:CodexBadge Content="PART_Footer"
                             Variant="Outline" />
        <controls:CodexButton Content="Action"
                              Size="Small"
                              Variant="Secondary" />
      </StackPanel>
    </controls:CodexCard.Footer>
  </controls:CodexCard>

  <controls:CodexCard Grid.Column="1"
                      IsInteractive="True"
                      Title="Interactive surface"
                      Description="The interactive class owns hover motion and border emphasis.">
    <StackPanel Spacing="8">
      <controls:CodexProgress Value="72"
                              Variant="Success" />
      <TextBlock Text="Pointerover changes the card surface without replacing slots."
                 TextWrapping="Wrap"
                 Opacity="0.72" />
    </StackPanel>
    <controls:CodexCard.Footer>
      <controls:CodexBadge Content="interactive"
                           Variant="Success" />
    </controls:CodexCard.Footer>
  </controls:CodexCard>
</Grid>
