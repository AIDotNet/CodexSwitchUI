<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Filtered rows"
                       Description="Toolbar input narrows rows while selected state remains explicit.">
    <controls:CodexField.Content>
      <StackPanel Spacing="10">
        <controls:CodexTextBox Width="260"
                               Text="success"
                               PlaceholderText="Filter emails..." />
        <controls:CodexTable IsCompact="True"
                             IsStriped="True"
                             IsHoverable="True"
                             TransitionKey="payments-success">
          <StackPanel>
            <controls:CodexTableHeader>
              <Grid ColumnDefinitions="42,1.05*,2.1*,*,86">
                <controls:CodexTableHead Alignment="Center">
                  <controls:CodexCheckBox />
                </controls:CodexTableHead>
                <controls:CodexTableHead Grid.Column="1"
                                         Content="Status" />
                <controls:CodexTableHead Grid.Column="2"
                                         Content="Email" />
                <controls:CodexTableHead Grid.Column="3"
                                         Content="Amount"
                                         Alignment="Right" />
                <controls:CodexTableHead Grid.Column="4" />
              </Grid>
            </controls:CodexTableHeader>
            <controls:CodexTableRow IsSelected="True">
              <Grid ColumnDefinitions="42,1.05*,2.1*,*,86">
                <controls:CodexTableCell Alignment="Center">
                  <controls:CodexCheckBox IsChecked="True" />
                </controls:CodexTableCell>
                <controls:CodexTableCell Grid.Column="1">
                  <controls:CodexBadge Content="success"
                                       Variant="Success" />
                </controls:CodexTableCell>
                <controls:CodexTableCell Grid.Column="2"
                                         Content="ken99@example.com" />
                <controls:CodexTableCell Grid.Column="3"
                                         Content="$316.00"
                                         Alignment="Right" />
                <controls:CodexTableCell Grid.Column="4"
                                         Content="..." />
              </Grid>
            </controls:CodexTableRow>
            <controls:CodexTableRow>
              <Grid ColumnDefinitions="42,1.05*,2.1*,*,86">
                <controls:CodexTableCell Alignment="Center">
                  <controls:CodexCheckBox />
                </controls:CodexTableCell>
                <controls:CodexTableCell Grid.Column="1">
                  <controls:CodexBadge Content="success"
                                       Variant="Success" />
                </controls:CodexTableCell>
                <controls:CodexTableCell Grid.Column="2"
                                         Content="silas22@example.com" />
                <controls:CodexTableCell Grid.Column="3"
                                         Content="$874.00"
                                         Alignment="Right" />
                <controls:CodexTableCell Grid.Column="4"
                                         Content="..." />
              </Grid>
            </controls:CodexTableRow>
          </StackPanel>
        </controls:CodexTable>
        <primitives:CodexText Role="Muted"
                              Text="1 of 2 row(s) selected." />
      </StackPanel>
    </controls:CodexField.Content>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Column visibility"
                       Description="The amount column is hidden through layout state.">
    <controls:CodexField.Content>
      <StackPanel Spacing="10">
        <controls:CodexDropdownButton Content="Columns"
                                      Size="Small"
                                      Variant="Outline"
                                      IsOpen="True"
                                      Align="End">
          <controls:CodexDropdownButton.DropDownContent>
            <StackPanel Width="184"
                        Spacing="8">
              <controls:CodexCheckBox Content="Status"
                                      IsChecked="True" />
              <controls:CodexCheckBox Content="Email"
                                      IsChecked="True" />
              <controls:CodexCheckBox Content="Amount"
                                      IsChecked="False" />
              <controls:CodexCheckBox Content="Actions"
                                      IsChecked="True" />
            </StackPanel>
          </controls:CodexDropdownButton.DropDownContent>
        </controls:CodexDropdownButton>
        <controls:CodexTable IsCompact="True"
                             IsStriped="True"
                             TransitionKey="payments-columns">
          <StackPanel>
            <controls:CodexTableHeader>
              <Grid ColumnDefinitions="42,1.05*,2.1*,0,86">
                <controls:CodexTableHead Alignment="Center">
                  <controls:CodexCheckBox />
                </controls:CodexTableHead>
                <controls:CodexTableHead Grid.Column="1"
                                         Content="Status" />
                <controls:CodexTableHead Grid.Column="2"
                                         Content="Email" />
                <controls:CodexTableHead Grid.Column="3"
                                         Content="Amount"
                                         IsVisible="False" />
                <controls:CodexTableHead Grid.Column="4" />
              </Grid>
            </controls:CodexTableHeader>
            <controls:CodexTableRow>
              <Grid ColumnDefinitions="42,1.05*,2.1*,0,86">
                <controls:CodexTableCell Alignment="Center">
                  <controls:CodexCheckBox />
                </controls:CodexTableCell>
                <controls:CodexTableCell Grid.Column="1">
                  <controls:CodexBadge Content="processing"
                                       Variant="Warning" />
                </controls:CodexTableCell>
                <controls:CodexTableCell Grid.Column="2"
                                         Content="abe45@example.com" />
                <controls:CodexTableCell Grid.Column="3"
                                         Content="$242.00"
                                         IsVisible="False" />
                <controls:CodexTableCell Grid.Column="4"
                                         Content="..." />
              </Grid>
            </controls:CodexTableRow>
          </StackPanel>
        </controls:CodexTable>
      </StackPanel>
    </controls:CodexField.Content>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Empty result"
                       Description="No-result state keeps header and caption mounted.">
    <controls:CodexTable IsHoverable="False"
                         TransitionKey="payments-empty">
      <StackPanel>
        <controls:CodexTableHeader>
          <Grid ColumnDefinitions="42,1.05*,2.1*,*,86">
            <controls:CodexTableHead Content="" />
            <controls:CodexTableHead Grid.Column="1"
                                     Content="Status" />
            <controls:CodexTableHead Grid.Column="2"
                                     Content="Email" />
            <controls:CodexTableHead Grid.Column="3"
                                     Content="Amount"
                                     Alignment="Right" />
            <controls:CodexTableHead Grid.Column="4" />
          </Grid>
        </controls:CodexTableHeader>
        <controls:CodexTableRow>
          <controls:CodexTableCell>
            <primitives:CodexText Role="Muted"
                                  Text="No results. Clear the filter or refresh the payment source." />
          </controls:CodexTableCell>
        </controls:CodexTableRow>
      </StackPanel>
    </controls:CodexTable>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Loading refresh"
                       Description="Opacity and transition key show refresh without replacing toolbar state.">
    <controls:CodexTable IsStriped="True"
                         IsCompact="True"
                         Opacity="0.72"
                         TransitionKey="payments-loading">
      <StackPanel>
        <controls:CodexTableHeader>
          <Grid ColumnDefinitions="42,1.05*,2.1*,*,86">
            <controls:CodexTableHead Content="" />
            <controls:CodexTableHead Grid.Column="1"
                                     Content="Status" />
            <controls:CodexTableHead Grid.Column="2"
                                     Content="Email" />
            <controls:CodexTableHead Grid.Column="3"
                                     Content="Amount"
                                     Alignment="Right" />
            <controls:CodexTableHead Grid.Column="4" />
          </Grid>
        </controls:CodexTableHeader>
        <controls:CodexTableRow IsSelected="True">
          <Grid ColumnDefinitions="42,1.05*,2.1*,*,86">
            <controls:CodexTableCell Alignment="Center">
              <controls:CodexCheckBox IsChecked="True" />
            </controls:CodexTableCell>
            <controls:CodexTableCell Grid.Column="1">
              <controls:CodexBadge Content="success"
                                   Variant="Success" />
            </controls:CodexTableCell>
            <controls:CodexTableCell Grid.Column="2"
                                     Content="ken99@example.com" />
            <controls:CodexTableCell Grid.Column="3"
                                     Content="$316.00"
                                     Alignment="Right" />
            <controls:CodexTableCell Grid.Column="4"
                                     Content="..." />
          </Grid>
        </controls:CodexTableRow>
      </StackPanel>
    </controls:CodexTable>
  </controls:CodexField>
</Grid>
