<controls:CodexRankedBarChart xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:controls="using:CodexSwitchUI.Controls"
                              x:CompileBindings="False"
                              Width="460"
                              IsCompact="True"
                              MaxVisibleItems="5"
                              ItemsSource="{Binding RankedItems}" />
