<controls:CodexChartContainer xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:controls="using:CodexSwitchUI.Controls"
                              xmlns:primitives="using:CodexSwitchUI.Primitives"
                              x:CompileBindings="False"
                              Width="640"
                              Title="Request trend"
                              Description="Native line chart wrapped by the shared ChartContainer helpers.">
  <controls:CodexChartContainer.Legend>
    <controls:CodexChartLegend>
      <controls:CodexChartLegendItem Content="Requests"
                                     Value="12.8K"
                                     IndicatorStyle="Line"
                                     IndicatorBrush="{DynamicResource CodexSwitch.PrimaryBrush}" />
    </controls:CodexChartLegend>
  </controls:CodexChartContainer.Legend>

  <controls:CodexChartContainer.Tooltip>
    <controls:CodexChartTooltipContent Label="Hover a point"
                                       IsOpen="True"
                                       IndicatorStyle="Line">
      <controls:CodexChartTooltipItem Content="Requests"
                                      Value="512"
                                      IndicatorStyle="Line"
                                      IndicatorBrush="{DynamicResource CodexSwitch.PrimaryBrush}" />
    </controls:CodexChartTooltipContent>
  </controls:CodexChartContainer.Tooltip>

  <controls:CodexChartContainer.Footer>
    <primitives:CodexText Role="Muted"
                          Text="Pointer hover exposes active-point metadata and tooltip interpolation." />
  </controls:CodexChartContainer.Footer>

  <controls:CodexLineChart Width="560"
                           ItemsSource="{Binding LineChartItems}" />
</controls:CodexChartContainer>
