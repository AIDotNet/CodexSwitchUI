<controls:CodexMenubar xmlns="https://github.com/avaloniaui"
                        xmlns:controls="using:CodexSwitchUI.Controls"
                        Loop="True">
  <controls:CodexMenubarMenu Header="File"
                              IsSubMenuOpen="True">
    <controls:CodexMenubarGroup Header="File">
      <controls:CodexMenubarItem Header="New tab"
                                 Shortcut="Cmd+T"
                                 IsActive="True" />
      <controls:CodexMenubarItem Header="New window"
                                 Shortcut="Cmd+N" />
      <controls:CodexMenubarItem Header="New private window"
                                 IsEnabled="False" />
    </controls:CodexMenubarGroup>
    <controls:CodexMenubarSeparator />
    <controls:CodexMenubarItem Header="Share">
      <controls:CodexMenubarItem Header="Email link" />
      <controls:CodexMenubarItem Header="Messages" />
      <controls:CodexMenubarItem Header="Notes" />
    </controls:CodexMenubarItem>
    <controls:CodexMenubarSeparator />
    <controls:CodexMenubarItem Header="Print"
                               Shortcut="Cmd+P" />
  </controls:CodexMenubarMenu>

  <controls:CodexMenubarMenu Header="Edit">
    <controls:CodexMenubarItem Header="Undo"
                               Shortcut="Cmd+Z" />
    <controls:CodexMenubarItem Header="Redo"
                               Shortcut="Shift+Cmd+Z" />
    <controls:CodexMenubarSeparator />
    <controls:CodexMenubarItem Header="Cut" />
    <controls:CodexMenubarItem Header="Copy" />
    <controls:CodexMenubarItem Header="Paste" />
  </controls:CodexMenubarMenu>

  <controls:CodexMenubarMenu Header="View">
    <controls:CodexMenubarCheckboxItem Header="Always show bookmarks bar" />
    <controls:CodexMenubarCheckboxItem Header="Always show full URLs"
                                       IsChecked="True" />
    <controls:CodexMenubarSeparator />
    <controls:CodexMenubarItem Header="Reload"
                               Shortcut="Cmd+R" />
  </controls:CodexMenubarMenu>

  <controls:CodexMenubarMenu Header="Profiles">
    <controls:CodexMenubarRadioItem Header="Andy" />
    <controls:CodexMenubarRadioItem Header="Benoit" />
    <controls:CodexMenubarRadioItem Header="Luis"
                                    IsChecked="True" />
  </controls:CodexMenubarMenu>
</controls:CodexMenubar>
