<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="14"
      RowSpacing="14">
  <controls:CodexField Label="Root and value"
                       Description="SelectedValue flows from the root to child item selection classes.">
    <controls:CodexSideNav SelectedValue="providers">
      <controls:CodexSideNav.Content>
        <StackPanel Spacing="6">
          <controls:CodexSideNavItem Value="providers"
                                     Icon="P"
                                     Content="Providers"
                                     Detail="Root selected" />
          <controls:CodexSideNavItem Value="sessions"
                                     Icon="S"
                                     Content="Sessions"
                                     Detail="Sibling row" />
        </StackPanel>
      </controls:CodexSideNav.Content>
    </controls:CodexSideNav>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Icon and detail"
                       Description="Icon and detail slots align without page-local row templates.">
    <StackPanel Spacing="6">
      <controls:CodexSideNavItem Value="icon"
                                 Icon="I"
                                 Content="Icon row"
                                 Detail="Secondary metadata" />
      <controls:CodexSideNavItem Value="plain"
                                 Content="No icon row"
                                 Detail="Content still aligns" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Selected row"
                       Description="Selected state owns background, border, foreground, and pressed feedback.">
    <StackPanel Spacing="6">
      <controls:CodexSideNavItem Value="active"
                                 Icon="A"
                                 Content="Active route"
                                 Detail="selected"
                                 IsSelected="True" />
      <controls:CodexSideNavItem Value="normal"
                                 Icon="N"
                                 Content="Normal route"
                                 Detail="idle" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Disabled row"
                       Description="Disabled rows remain visible and cannot become the root selected value.">
    <StackPanel Spacing="6">
      <controls:CodexSideNavItem Value="enabled"
                                 Icon="E"
                                 Content="Enabled row"
                                 Detail="available" />
      <controls:CodexSideNavItem Value="locked"
                                 Icon="L"
                                 Content="Locked row"
                                 Detail="disabled"
                                 IsEnabled="False" />
    </StackPanel>
  </controls:CodexField>
</Grid>
