<StackPanel xmlns="https://github.com/avaloniaui"
            xmlns:controls="using:CodexSwitchUI.Controls"
            Spacing="12">
  <TextBlock Text="ItemSelected: choose a context leaf."
             Opacity="0.72" />
  <Grid ColumnDefinitions="*,*"
        RowDefinitions="Auto,Auto"
        ColumnSpacing="14"
        RowSpacing="14">
  <controls:CodexContextMenu MinWidth="240"
                             Placement="Right"
                             Classes="context-menu-open">
    <controls:CodexContextMenuLabel Content="Right side" />
    <controls:CodexContextMenuItem Header="Open session"
                                   Shortcut="Cmd+O"
                                   IsActive="True" />
    <controls:CodexContextMenuItem Header="Move to"
                                   IsSubMenuOpen="True"
                                   SubMenuPlacement="RightEdgeAlignedTop">
      <controls:CodexContextMenuItem Header="Archive" />
      <controls:CodexContextMenuItem Header="Favorites" />
    </controls:CodexContextMenuItem>
  </controls:CodexContextMenu>

  <controls:CodexContextMenu Grid.Column="1"
                             MinWidth="240"
                             Placement="Left"
                             Classes="context-menu-open">
    <controls:CodexContextMenuLabel Content="Left side" />
    <controls:CodexContextMenuItem Header="Move left"
                                   IsSubMenuOpen="True"
                                   SubMenuPlacement="LeftEdgeAlignedTop">
      <controls:CodexContextMenuItem Header="Inbox" />
      <controls:CodexContextMenuItem Header="Backlog" />
    </controls:CodexContextMenuItem>
    <controls:CodexContextMenuItem Header="Delete"
                                   IsEnabled="False" />
  </controls:CodexContextMenu>

  <controls:CodexContextMenu Grid.Row="1"
                             MinWidth="240"
                             Placement="Bottom"
                             Classes="context-menu-open"
                             IsLoading="True">
    <controls:CodexContextMenuLabel Content="Loading gate"
                                    IsInset="True" />
    <controls:CodexContextMenuItem Header="Copy link"
                                   Shortcut="Cmd+L" />
    <controls:CodexContextMenuItem Header="Move blocked">
      <controls:CodexContextMenuItem Header="Archive" />
      <controls:CodexContextMenuItem Header="Favorites" />
    </controls:CodexContextMenuItem>
  </controls:CodexContextMenu>

  <controls:CodexContextMenu Grid.Row="1"
                             Grid.Column="1"
                             MinWidth="240"
                             Placement="Top"
                             Classes="context-menu-open">
    <controls:CodexContextMenuLabel Content="Selection" />
    <controls:CodexContextMenuItem Header="Pinned"
                                   ToggleType="CheckBox"
                                   IsChecked="True" />
    <controls:CodexContextMenuItem Header="Compact mode"
                                   ToggleType="Radio"
                                   IsChecked="True"
                                   IsInset="True" />
    <controls:CodexContextMenuItem Header="Disabled leaf"
                                   IsEnabled="False" />
  </controls:CodexContextMenu>
  </Grid>
</StackPanel>
