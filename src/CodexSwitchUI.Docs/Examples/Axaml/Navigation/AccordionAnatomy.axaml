<controls:CodexAccordion xmlns="https://github.com/avaloniaui"
                         xmlns:controls="using:CodexSwitchUI.Controls"
                         xmlns:primitives="using:CodexSwitchUI.Primitives"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         Type="Multiple">
  <controls:CodexAccordionItem Value="trigger"
                               IsOpen="True">
    <controls:CodexAccordionItem.Header>
      <StackPanel Orientation="Horizontal"
                  Spacing="8">
        <primitives:CodexText Text="Trigger slot"
                              Role="Body" />
        <controls:CodexBadge Content="Open"
                             Size="Small" />
      </StackPanel>
    </controls:CodexAccordionItem.Header>
    <StackPanel Spacing="8">
      <primitives:CodexText Text="Header content, chevron, focus ring, and measured content stay inside the item template."
                            Role="Muted"
                            TextWrapping="Wrap" />
      <controls:CodexButton Content="Primary action"
                            Size="Small"
                            HorizontalAlignment="Left" />
    </StackPanel>
  </controls:CodexAccordionItem>

  <controls:CodexAccordionItem Value="nested"
                               Header="Nested form controls"
                               IsOpen="True">
    <StackPanel Spacing="10">
      <controls:CodexSwitch Content="Enable retry queue"
                            IsChecked="True" />
      <controls:CodexSelect SelectedIndex="0">
        <x:String>Standard priority</x:String>
        <x:String>High priority</x:String>
      </controls:CodexSelect>
    </StackPanel>
  </controls:CodexAccordionItem>
</controls:CodexAccordion>
