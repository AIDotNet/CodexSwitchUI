<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Line template"
                       Description="PART_Line owns the visual surface and tokenized brush transition.">
    <StackPanel Spacing="10">
      <primitives:CodexText Role="Subtitle"
                            Text="Before divider" />
      <controls:CodexSeparator />
      <TextBlock Text="After divider" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Vertical slot"
                       Description="Vertical orientation keeps explicit width and height stable in tool rows.">
    <StackPanel Orientation="Horizontal"
                Spacing="12">
      <controls:CodexButton Content="Undo"
                            Size="Small" />
      <controls:CodexSeparator Orientation="Vertical"
                               Height="36" />
      <controls:CodexButton Content="Redo"
                            Size="Small"
                            Variant="Secondary" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Density classes"
                       Description="Small, medium, large, and icon sizes map to stable line dimensions.">
    <StackPanel Spacing="12">
      <controls:CodexSeparator Size="Small" />
      <controls:CodexSeparator />
      <controls:CodexSeparator Size="Large" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Composition"
                       Description="Separator stays decorative and lets surrounding controls own interaction.">
    <StackPanel Orientation="Horizontal"
                Spacing="10">
      <controls:CodexButton Content="Cut"
                            Size="Small"
                            Variant="Ghost" />
      <controls:CodexSeparator Orientation="Vertical"
                               Size="Large"
                               Height="34" />
      <controls:CodexButton Content="Paste"
                            Size="Small"
                            Variant="Ghost" />
    </StackPanel>
  </controls:CodexField>
</Grid>
