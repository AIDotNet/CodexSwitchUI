<StackPanel xmlns="https://github.com/avaloniaui"
            xmlns:controls="using:CodexSwitchUI.Controls"
            Spacing="14">
  <controls:CodexMenubar Loop="True">
    <controls:CodexMenubarMenu Header="File">
      <controls:CodexMenubarLabel Content="Workspace" />
      <controls:CodexMenubarGroup Header="File">
        <controls:CodexMenubarItem Header="New tab"
                                   Shortcut="Cmd+T" />
        <controls:CodexMenubarItem Header="New window"
                                   Shortcut="Cmd+N" />
      </controls:CodexMenubarGroup>
      <controls:CodexMenubarSeparator />
      <controls:CodexMenubarItem Header="Share">
        <controls:CodexMenubarItem Header="Copy link" />
        <controls:CodexMenubarItem Header="Invite member" />
      </controls:CodexMenubarItem>
    </controls:CodexMenubarMenu>

    <controls:CodexMenubarMenu Header="Edit">
      <controls:CodexMenubarItem Header="Undo"
                                 Shortcut="Cmd+Z" />
      <controls:CodexMenubarItem Header="Redo"
                                 Shortcut="Shift+Cmd+Z" />
      <controls:CodexMenubarSeparator />
      <controls:CodexMenubarItem Header="Find">
        <controls:CodexMenubarItem Header="Search the web" />
        <controls:CodexMenubarSeparator />
        <controls:CodexMenubarItem Header="Find"
                                   Shortcut="Cmd+F" />
        <controls:CodexMenubarItem Header="Find next"
                                   Shortcut="Cmd+G" />
      </controls:CodexMenubarItem>
    </controls:CodexMenubarMenu>

    <controls:CodexMenubarMenu Header="View">
      <controls:CodexMenubarCheckboxItem Header="Always show bookmarks bar" />
      <controls:CodexMenubarCheckboxItem Header="Always show full URLs"
                                         IsChecked="True" />
    </controls:CodexMenubarMenu>

    <controls:CodexMenubarMenu Header="Profiles">
      <controls:CodexMenubarRadioItem Header="Fast" />
      <controls:CodexMenubarRadioItem Header="Balanced" />
      <controls:CodexMenubarRadioItem Header="Deep reasoning"
                                      IsChecked="True" />
    </controls:CodexMenubarMenu>
  </controls:CodexMenubar>

  <controls:CodexMenubar Size="Small">
    <controls:CodexMenubarMenu Header="Project">
      <controls:CodexMenubarLabel Content="Workspace" />
      <controls:CodexMenubarItem Header="Open folder"
                                 Shortcut="Cmd+O" />
      <controls:CodexMenubarItem Header="Recent files" />
    </controls:CodexMenubarMenu>
    <controls:CodexMenubarMenu Header="Mode">
      <controls:CodexMenubarRadioItem Header="Fast"
                                      IsChecked="True" />
      <controls:CodexMenubarRadioItem Header="Balanced" />
      <controls:CodexMenubarRadioItem Header="Deep reasoning" />
    </controls:CodexMenubarMenu>
  </controls:CodexMenubar>
</StackPanel>
