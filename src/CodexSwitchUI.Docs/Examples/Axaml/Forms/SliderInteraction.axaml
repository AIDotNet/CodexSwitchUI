<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Value events"
                       Description="Pointer drag, track click, and host updates raise ValueChanging before ValueCommitted.">
    <StackPanel Spacing="8">
      <controls:CodexSlider Minimum="0"
                            Maximum="100"
                            Value="48"
                            TickFrequency="1"
                            MinWidth="320" />
      <TextBlock Text="ValueChanging and ValueCommitted update this status."
                 TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal"
                  Spacing="8">
        <controls:CodexButton Content="Set 24"
                              Size="Small"
                              Variant="Secondary" />
        <controls:CodexButton Content="Set 76"
                              Size="Small"
                              Variant="Secondary" />
        <controls:CodexButton Content="Commit"
                              Size="Small"
                              Variant="Ghost" />
      </StackPanel>
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Keyboard commit"
                       Description="Arrow, Page, Home, and End keys update Value and commit on key release.">
    <StackPanel Spacing="8">
      <controls:CodexSlider Minimum="0"
                            Maximum="2"
                            Value="0.8"
                            TickFrequency="0.1"
                            Size="Large"
                            Intent="Success"
                            MinWidth="320" />
      <TextBlock Text="Focus the slider, then use Arrow/Page/Home/End."
                 TextWrapping="Wrap" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Vertical direction"
                       Description="Vertical orientation keeps the same thumb and track contract.">
    <controls:CodexSlider Minimum="0"
                          Maximum="100"
                          Value="66"
                          Orientation="Vertical"
                          Intent="Warning"
                          Height="130" />
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Disabled guard"
                       Description="Disabled sliders keep drag and keyboard changes locked.">
    <controls:CodexSlider Minimum="0"
                          Maximum="100"
                          Value="72"
                          IsEnabled="False"
                          MinWidth="320" />
  </controls:CodexField>
</Grid>
