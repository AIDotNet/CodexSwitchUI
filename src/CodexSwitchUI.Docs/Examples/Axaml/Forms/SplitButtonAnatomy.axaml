<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="14"
      RowSpacing="14">
  <controls:CodexField Label="Primary and trigger parts"
                       Description="The root composes a primary CodexButton, divider, menu CodexButton, and rotating chevron.">
    <controls:CodexSplitButton Content="Run sync"
                               IsOpen="True"
                               IsArrowVisible="True">
      <controls:CodexSplitButton.DropDownContent>
        <StackPanel Width="188"
                    Spacing="6">
          <controls:CodexButton Content="Run once"
                                Variant="Ghost"
                                HorizontalAlignment="Stretch" />
          <controls:CodexButton Content="Schedule"
                                Variant="Ghost"
                                HorizontalAlignment="Stretch" />
          <controls:CodexButton Content="Stop"
                                Variant="Destructive"
                                HorizontalAlignment="Stretch" />
        </StackPanel>
      </controls:CodexSplitButton.DropDownContent>
    </controls:CodexSplitButton>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Popup surface"
                       Description="Dropdown content lives in the owned popup surface with side-aware opacity and transform motion.">
    <controls:CodexSplitButton Content="Deploy"
                               IsOpen="True"
                               Placement="Top"
                               Align="End"
                               Variant="Secondary">
      <controls:CodexSplitButton.DropDownContent>
        <StackPanel Width="188"
                    Spacing="6">
          <controls:CodexButton Content="Preview"
                                Variant="Ghost"
                                HorizontalAlignment="Stretch" />
          <controls:CodexButton Content="Promote"
                                Variant="Ghost"
                                HorizontalAlignment="Stretch" />
          <controls:CodexButton Content="Rollback"
                                Variant="Ghost"
                                HorizontalAlignment="Stretch" />
        </StackPanel>
      </controls:CodexSplitButton.DropDownContent>
    </controls:CodexSplitButton>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Loading and disabled"
                       Description="Loading suppresses both child buttons; disabled keeps the popup trigger unavailable.">
    <StackPanel Spacing="10">
      <controls:CodexSplitButton Content="Publishing"
                                 IsLoading="True"
                                 DropDownContent="Loading state keeps content mounted." />
      <controls:CodexSplitButton Content="Locked"
                                 IsEnabled="False"
                                 DropDownContent="Disabled trigger never opens." />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Close policy"
                       Description="CloseOnItemSelected and arrow visibility are root-owned so menus can match Web disclosure behavior.">
    <controls:CodexSplitButton Content="Keep open"
                               IsOpen="True"
                               CloseOnItemSelected="False"
                               IsArrowVisible="False"
                               Variant="Outline">
      <controls:CodexSplitButton.DropDownContent>
        <StackPanel Width="188"
                    Spacing="6">
          <controls:CodexButton Content="Preview"
                                Variant="Ghost"
                                HorizontalAlignment="Stretch" />
          <controls:CodexButton Content="Copy command"
                                Variant="Ghost"
                                HorizontalAlignment="Stretch" />
          <controls:CodexButton Content="Open logs"
                                Variant="Ghost"
                                HorizontalAlignment="Stretch" />
        </StackPanel>
      </controls:CodexSplitButton.DropDownContent>
    </controls:CodexSplitButton>
  </controls:CodexField>
</Grid>
