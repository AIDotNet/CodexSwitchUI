<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Required"
                       IsRequired="True"
                       Description="Required marker is component-owned.">
    <controls:CodexTextBox PlaceholderText="Provider name" />
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Success"
                       Message="Connection verified."
                       Intent="Success">
    <controls:CodexTextBox Text="gpt-5" />
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Error"
                       Message="API key is required."
                       Intent="Error">
    <controls:CodexTextBox Intent="Error"
                           PasswordChar="*" />
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Disabled"
                       Description="Child disabled state stays aligned.">
    <controls:CodexTextBox Text="Locked"
                           IsEnabled="False" />
  </controls:CodexField>
</Grid>
