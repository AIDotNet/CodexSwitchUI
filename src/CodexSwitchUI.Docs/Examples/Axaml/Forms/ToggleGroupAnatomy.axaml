<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="12"
      RowSpacing="12">
  <controls:CodexStatCard Label="Root"
                          Value="ToggleGroup"
                          Detail="type" />
  <controls:CodexStatCard Grid.Column="1"
                          Label="Items"
                          Value="ToggleGroupItem"
                          Detail="value" />
  <controls:CodexStatCard Grid.Column="2"
                          Label="Selection"
                          Value="SelectedValue"
                          Detail="single" />
  <controls:CodexStatCard Grid.Row="1"
                          Label="Values"
                          Value="SelectedValues"
                          Detail="multiple" />
  <controls:CodexStatCard Grid.Row="1"
                          Grid.Column="1"
                          Label="Spacing"
                          Value="0-4"
                          Detail="connected" />
  <controls:CodexStatCard Grid.Row="1"
                          Grid.Column="2"
                          Label="Keys"
                          Value="Roving"
                          Detail="loop" />
</Grid>
