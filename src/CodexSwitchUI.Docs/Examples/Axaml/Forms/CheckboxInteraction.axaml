<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Pointer toggle"
                       Description="Pointer release and Space use the same native checked path.">
    <StackPanel Spacing="10">
      <controls:CodexCheckBox Content="Enable provider routing"
                              IsChecked="True" />
      <controls:CodexCheckBox Content="Sync archived sessions" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Three-state cycle"
                       Description="Indeterminate state keeps its own glyph animation.">
    <StackPanel Spacing="10">
      <controls:CodexCheckBox Content="Mixed provider selection"
                              IsThreeState="True"
                              IsChecked="{x:Null}" />
      <controls:CodexCheckBox Content="Partially migrated"
                              IsThreeState="True"
                              IsChecked="True"
                              Intent="Warning" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Keyboard focus target"
                       Description="Keyboard focus exposes the shared focus-visible ring.">
    <StackPanel Spacing="10">
      <controls:CodexCheckBox Content="Focus-visible route"
                              Size="Large" />
      <controls:CodexCheckBox Content="Small dense row"
                              Size="Small"
                              IsChecked="True" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Disabled guard"
                       Description="Disabled state blocks pointer and keyboard toggles.">
    <StackPanel Spacing="10">
      <controls:CodexCheckBox Content="Locked on"
                              IsChecked="True"
                              IsEnabled="False" />
      <controls:CodexCheckBox Content="Locked off"
                              Intent="Error"
                              IsEnabled="False" />
    </StackPanel>
  </controls:CodexField>
</Grid>
