<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Focus within"
                       Description="Focusing the input paints the group ring while the caret stays on the child input.">
    <controls:CodexInputGroup>
      <controls:CodexInputGroupAddon Content="Search" />
      <controls:CodexInputGroupInput Text="provider"
                                     SelectionStart="0"
                                     SelectionEnd="8" />
      <controls:CodexInputGroupAddon Align="InlineEnd"
                                     Content="12 results" />
    </controls:CodexInputGroup>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Loading button"
                       Description="The button keeps the CodexButton loading suppression path inside the addon.">
    <controls:CodexInputGroup>
      <controls:CodexInputGroupInput Text="Saving changes..." />
      <controls:CodexInputGroupAddon Align="InlineEnd">
        <controls:CodexInputGroupButton Content="Save"
                                        IsLoading="True"
                                        LoadingContent="Saving" />
      </controls:CodexInputGroupAddon>
    </controls:CodexInputGroup>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Read-only control">
    <controls:CodexInputGroup>
      <controls:CodexInputGroupAddon Content="Route" />
      <controls:CodexInputGroupInput Text="/v1/responses"
                                     IsReadOnly="True" />
      <controls:CodexInputGroupAddon Align="InlineEnd">
        <controls:CodexInputGroupButton Content="Copy" />
      </controls:CodexInputGroupAddon>
    </controls:CodexInputGroup>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Disabled action">
    <controls:CodexInputGroup>
      <controls:CodexInputGroupInput PlaceholderText="Type to search" />
      <controls:CodexInputGroupAddon Align="InlineEnd">
        <controls:CodexInputGroupButton Content="Search"
                                        IsEnabled="False" />
      </controls:CodexInputGroupAddon>
    </controls:CodexInputGroup>
  </controls:CodexField>
</Grid>
