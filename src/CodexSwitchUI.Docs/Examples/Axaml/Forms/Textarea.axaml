<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      ColumnSpacing="16">
  <controls:CodexField Label="Request body"
                       Description="Multiline input keeps scroll and wrapping inside the template.">
    <controls:CodexTextarea MinHeight="110"
                            PlaceholderText="Optional JSON" />
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Readonly log">
    <controls:CodexTextarea Text="token_budget: 128000&#x0a;reasoning: medium"
                            IsReadOnly="True"
                            MinHeight="110"
                            Size="Large" />
  </controls:CodexField>
</Grid>
