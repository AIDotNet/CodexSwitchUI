<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Root and groups"
                       Description="The root owns text, max length, pattern filtering, and grouped slot sync.">
    <controls:CodexInputOtp Text="123456"
                            MaxLength="6"
                            Pattern="^[0-9]$">
      <controls:CodexInputOtpGroup>
        <controls:CodexInputOtpSlot Index="0" />
        <controls:CodexInputOtpSlot Index="1" />
        <controls:CodexInputOtpSlot Index="2" />
      </controls:CodexInputOtpGroup>
      <controls:CodexInputOtpSeparator />
      <controls:CodexInputOtpGroup>
        <controls:CodexInputOtpSlot Index="3" />
        <controls:CodexInputOtpSlot Index="4" />
        <controls:CodexInputOtpSlot Index="5" />
      </controls:CodexInputOtpGroup>
    </controls:CodexInputOtp>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Slot anatomy"
                       Description="Slots expose character, active, invalid, and size state independently.">
    <StackPanel Orientation="Horizontal"
                Spacing="8">
      <controls:CodexInputOtpSlot Index="0"
                                  Character="4" />
      <controls:CodexInputOtpSlot Index="1"
                                  Character="9"
                                  IsActive="True" />
      <controls:CodexInputOtpSlot Index="2"
                                  IsInvalid="True" />
      <controls:CodexInputOtpSeparator />
      <controls:CodexInputOtpSlot Index="3"
                                  Size="Small"
                                  Character="A" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Recovery grouping"
                       Description="Separators can split longer recovery codes into readable groups.">
    <controls:CodexInputOtp Text="12AB34CD"
                            MaxLength="8"
                            Pattern="^[A-Za-z0-9]$"
                            Size="Small">
      <controls:CodexInputOtpGroup>
        <controls:CodexInputOtpSlot Index="0" />
        <controls:CodexInputOtpSlot Index="1" />
      </controls:CodexInputOtpGroup>
      <controls:CodexInputOtpSeparator />
      <controls:CodexInputOtpGroup>
        <controls:CodexInputOtpSlot Index="2" />
        <controls:CodexInputOtpSlot Index="3" />
      </controls:CodexInputOtpGroup>
      <controls:CodexInputOtpSeparator />
      <controls:CodexInputOtpGroup>
        <controls:CodexInputOtpSlot Index="4" />
        <controls:CodexInputOtpSlot Index="5" />
      </controls:CodexInputOtpGroup>
      <controls:CodexInputOtpSeparator />
      <controls:CodexInputOtpGroup>
        <controls:CodexInputOtpSlot Index="6" />
        <controls:CodexInputOtpSlot Index="7" />
      </controls:CodexInputOtpGroup>
    </controls:CodexInputOtp>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Invalid anatomy"
                       Description="Invalid intent flows from the root to every owned slot."
                       Intent="Error"
                       Message="The verification code is incorrect.">
    <controls:CodexInputOtp Text="000000"
                            MaxLength="6"
                            IsInvalid="True"
                            Intent="Error">
      <controls:CodexInputOtpGroup>
        <controls:CodexInputOtpSlot Index="0" />
        <controls:CodexInputOtpSlot Index="1" />
        <controls:CodexInputOtpSlot Index="2" />
      </controls:CodexInputOtpGroup>
      <controls:CodexInputOtpSeparator />
      <controls:CodexInputOtpGroup>
        <controls:CodexInputOtpSlot Index="3" />
        <controls:CodexInputOtpSlot Index="4" />
        <controls:CodexInputOtpSlot Index="5" />
      </controls:CodexInputOtpGroup>
    </controls:CodexInputOtp>
  </controls:CodexField>
</Grid>
