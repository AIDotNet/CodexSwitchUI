<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <StackPanel Spacing="10">
    <controls:CodexField Label="Provider name"
                         Description="Required before the provider can be saved."
                         Message="Provider name is required."
                         IsRequired="True"
                         Intent="Error">
      <controls:CodexTextBox PlaceholderText="Provider name"
                             Intent="Error"
                             MinWidth="240" />
    </controls:CodexField>
    <StackPanel Orientation="Horizontal"
                Spacing="8">
      <controls:CodexButton Content="Validate"
                            Size="Small" />
      <controls:CodexButton Content="Toggle disabled"
                            Variant="Secondary"
                            Size="Small" />
    </StackPanel>
  </StackPanel>

  <controls:CodexField Grid.Column="1"
                       Label="Child focus target"
                       Description="Focusable children own focus-visible while the field keeps label alignment."
                       Message="Select a default route.">
    <controls:CodexSelect SelectedIndex="0"
                          MinWidth="240">
      <ComboBoxItem Content="Primary" />
      <ComboBoxItem Content="Fallback" />
      <ComboBoxItem Content="Disabled" />
    </controls:CodexSelect>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Textarea validation"
                       Description="Multiline controls keep wrapping and scroll behavior inside the field body."
                       Message="Notes are optional.">
    <controls:CodexTextarea Text="stream: true&#x0a;reasoning: medium"
                            MinHeight="92" />
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Disabled child guard"
                       Description="Field chrome remains visible while the child control uses disabled opacity."
                       Message="Inherited provider cannot be edited.">
    <controls:CodexTextBox Text="Locked route"
                           IsEnabled="False"
                           MinWidth="240" />
  </controls:CodexField>
</Grid>
