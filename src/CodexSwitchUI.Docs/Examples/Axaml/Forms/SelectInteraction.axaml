<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Open popup"
                       Description="Trigger, selected item, popup-open class, OpenChanged, and ValueChanged share one state path.">
    <StackPanel Spacing="8">
      <controls:CodexSelect SelectedIndex="0"
                            IsDropDownOpen="True"
                            MinWidth="240">
        <x:String>OpenAI</x:String>
        <x:String>Claude</x:String>
        <x:String>Responses</x:String>
      </controls:CodexSelect>
      <TextBlock Text="OpenChanged and ValueChanged update this status."
                 TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal"
                  Spacing="8">
        <controls:CodexButton Content="Claude"
                              Size="Small"
                              Variant="Secondary" />
        <controls:CodexButton Content="Close"
                              Size="Small"
                              Variant="Ghost" />
      </StackPanel>
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Keyboard target"
                       Description="Arrow keys and Enter use the native selection model.">
    <controls:CodexSelect SelectedIndex="1"
                          MinWidth="240">
      <x:String>Primary</x:String>
      <x:String>Fallback</x:String>
      <x:String>Disabled</x:String>
    </controls:CodexSelect>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Warning intent"
                       Message="Fallback provider is active."
                       Intent="Warning">
    <controls:CodexSelect SelectedIndex="1"
                          Intent="Warning"
                          Size="Small"
                          MinWidth="240">
      <x:String>Primary</x:String>
      <x:String>Fallback</x:String>
    </controls:CodexSelect>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Disabled trigger"
                       Description="Disabled state prevents popup activation.">
    <controls:CodexSelect SelectedIndex="0"
                          IsEnabled="False"
                          MinWidth="240">
      <x:String>Locked</x:String>
    </controls:CodexSelect>
  </controls:CodexField>
</Grid>
