<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      ColumnSpacing="16">
  <controls:CodexField Label="Input group"
                       Description="Input, clear button, trigger, popup, list, empty, and check indicator are component-owned.">
    <controls:CodexCombobox PlaceholderText="Search provider"
                            Text="cla"
                            IsOpen="True"
                            AutoHighlight="True"
                            IsClearVisible="True"
                            MinWidth="260">
      <x:String>OpenAI</x:String>
      <x:String>Claude</x:String>
      <x:String>Gemini</x:String>
      <x:String>Local</x:String>
    </controls:CodexCombobox>
  </controls:CodexField>

  <controls:CodexInputGroup Grid.Column="1">
    <controls:CodexInputGroupAddon Content="Route" />
    <controls:CodexCombobox Classes="input-group-control"
                            PlaceholderText="Search route"
                            SelectedItem="Balanced">
      <x:String>Balanced</x:String>
      <x:String>Lowest latency</x:String>
      <x:String>Lowest cost</x:String>
    </controls:CodexCombobox>
    <controls:CodexInputGroupButton Content="Apply" />
  </controls:CodexInputGroup>
</Grid>
