<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Auto highlight"
                       Description="Arrow keys move the highlighted item; Enter commits it and reports keyboard source metadata.">
    <StackPanel Spacing="8">
      <controls:CodexCombobox Text="n"
                              AutoHighlight="True"
                              MinWidth="240">
        <x:String>Next.js</x:String>
        <x:String>SvelteKit</x:String>
        <x:String>Nuxt.js</x:String>
        <x:String>Remix</x:String>
        <x:String>Astro</x:String>
      </controls:CodexCombobox>
      <StackPanel Orientation="Horizontal"
                  Spacing="8">
        <controls:CodexButton Content="Open"
                              Size="Small"
                              Variant="Secondary" />
        <controls:CodexButton Content="Arrow down"
                              Size="Small"
                              Variant="Outline" />
        <controls:CodexButton Content="Enter"
                              Size="Small" />
        <controls:CodexButton Content="Clear"
                              Size="Small"
                              Variant="Ghost" />
      </StackPanel>
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Clear button"
                       Description="Clear resets selected value and input text while reporting clear source metadata.">
    <controls:CodexCombobox SelectedItem="SvelteKit"
                            IsClearVisible="True"
                            MinWidth="240">
      <x:String>Next.js</x:String>
      <x:String>SvelteKit</x:String>
      <x:String>Nuxt.js</x:String>
      <x:String>Remix</x:String>
      <x:String>Astro</x:String>
    </controls:CodexCombobox>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Manual close"
                       Description="CloseOnSelect can be disabled for batch review flows.">
    <controls:CodexCombobox Text="re"
                            CloseOnSelect="False"
                            MinWidth="240">
      <x:String>Next.js</x:String>
      <x:String>SvelteKit</x:String>
      <x:String>Nuxt.js</x:String>
      <x:String>Remix</x:String>
      <x:String>Astro</x:String>
    </controls:CodexCombobox>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Loading"
                       Description="Loading suppresses open and selection changes.">
    <controls:CodexCombobox IsLoading="True"
                            LoadingContent="Loading frameworks..."
                            MinWidth="240">
      <x:String>Next.js</x:String>
      <x:String>SvelteKit</x:String>
      <x:String>Nuxt.js</x:String>
      <x:String>Remix</x:String>
      <x:String>Astro</x:String>
    </controls:CodexCombobox>
  </controls:CodexField>
</Grid>
