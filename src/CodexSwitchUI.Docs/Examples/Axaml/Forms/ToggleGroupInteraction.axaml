<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Single selection"
                       Description="Selecting one item clears siblings; pressing it again can clear the value.">
    <StackPanel Spacing="10">
      <controls:CodexToggleGroup Spacing="0"
                                 SelectedValue="center">
        <controls:CodexToggleGroupItem Content="Left"
                                       Value="left" />
        <controls:CodexToggleGroupItem Content="Center"
                                       Value="center" />
        <controls:CodexToggleGroupItem Content="Right"
                                       Value="right" />
      </controls:CodexToggleGroup>
      <TextBlock Text="Single value: center (source=Programmatic)."
                 Opacity="0.72" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Multiple selection"
                       Description="Each item keeps an independent pressed state.">
    <StackPanel Spacing="10">
      <controls:CodexToggleGroup Type="Multiple"
                                 Variant="Outline">
        <controls:CodexToggleGroupItem Content="Bold"
                                       Value="bold"
                                       IsPressed="True" />
        <controls:CodexToggleGroupItem Content="Italic"
                                       Value="italic"
                                       IsPressed="True" />
        <controls:CodexToggleGroupItem Content="Underline"
                                       Value="underline" />
      </controls:CodexToggleGroup>
      <TextBlock Text="Multiple values: bold, italic (source=Programmatic)."
                 Opacity="0.72" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Roving keys"
                       Description="Right/Left move focus; Enter or Space reports source=Keyboard.">
    <controls:CodexToggleGroup IsLoop="False"
                               SelectedValue="preview">
      <controls:CodexToggleGroupItem Content="Preview"
                                     Value="preview" />
      <controls:CodexToggleGroupItem Content="Code"
                                     Value="code" />
      <controls:CodexToggleGroupItem Content="Disabled"
                                     Value="disabled"
                                     IsEnabled="False" />
      <controls:CodexToggleGroupItem Content="Events"
                                     Value="events" />
    </controls:CodexToggleGroup>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Vertical orientation"
                       Description="Up/Down move through enabled vertical items while primary release reports source=Pointer.">
    <controls:CodexToggleGroup Orientation="Vertical"
                               Variant="Outline"
                               SelectedValue="list">
      <controls:CodexToggleGroupItem Content="List"
                                     Value="list" />
      <controls:CodexToggleGroupItem Content="Grid"
                                     Value="grid" />
      <controls:CodexToggleGroupItem Content="Cards"
                                     Value="cards" />
    </controls:CodexToggleGroup>
  </controls:CodexField>
</Grid>
