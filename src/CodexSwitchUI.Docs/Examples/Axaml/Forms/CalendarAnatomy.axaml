<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Single grid anatomy"
                       Description="Header, weekday row, outside days, selected day, and active roving target stay component-owned.">
    <controls:CodexCalendar DisplayDate="2026-05-01"
                            SelectedDate="2026-05-20"
                            ActiveDate="2026-05-22"
                            HorizontalAlignment="Left" />
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Range anatomy"
                       Description="Range edges and middle days map to separate classes for Web-equivalent styling.">
    <controls:CodexCalendar DisplayDate="2026-02-01"
                            SelectionMode="Range"
                            RangeStart="2026-02-09"
                            RangeEnd="2026-02-18"
                            ActiveDate="2026-02-18"
                            HorizontalAlignment="Left" />
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Week number anatomy"
                       Description="Monday-first layout adds a leading week-number column without changing day button slots.">
    <controls:CodexCalendar DisplayDate="2026-01-01"
                            SelectedDate="2026-01-14"
                            ActiveDate="2026-01-14"
                            FirstDayOfWeek="Monday"
                            ShowWeekNumbers="True"
                            Size="Small"
                            HorizontalAlignment="Left" />
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Bounded day anatomy"
                       Description="MinDate and MaxDate produce unavailable day cells while preserving grid rhythm."
                       Intent="Warning"
                       Message="Unavailable days remain visible but cannot activate.">
    <controls:CodexCalendar DisplayDate="2026-03-01"
                            SelectedDate="2026-03-16"
                            ActiveDate="2026-03-16"
                            MinDate="2026-03-09"
                            MaxDate="2026-03-23"
                            Intent="Warning"
                            HorizontalAlignment="Left" />
  </controls:CodexField>
</Grid>
