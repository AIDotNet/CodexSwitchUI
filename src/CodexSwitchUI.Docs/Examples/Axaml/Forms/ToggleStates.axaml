<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Pressed">
    <controls:CodexToggle Content="Bookmark"
                          IsPressed="True" />
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Outline">
    <controls:CodexToggle Content="Italic"
                          Variant="Outline"
                          IsPressed="True" />
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Sizes">
    <StackPanel Orientation="Horizontal"
                Spacing="8">
      <controls:CodexToggle Content="Small"
                            Size="Small" />
      <controls:CodexToggle Content="Default"
                            IsPressed="True" />
      <controls:CodexToggle Content="Large"
                            Size="Large" />
    </StackPanel>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Disabled">
    <StackPanel Orientation="Horizontal"
                Spacing="8">
      <controls:CodexToggle Content="Disabled on"
                            IsPressed="True"
                            IsEnabled="False" />
      <controls:CodexToggle Content="Disabled off"
                            IsEnabled="False" />
    </StackPanel>
  </controls:CodexField>
</Grid>
