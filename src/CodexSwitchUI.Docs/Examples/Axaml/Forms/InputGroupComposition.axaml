<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Text addons">
    <controls:CodexInputGroup>
      <controls:CodexInputGroupAddon Content="https://" />
      <controls:CodexInputGroupInput Text="example.com" />
      <controls:CodexInputGroupAddon Align="InlineEnd"
                                     Content=".com" />
    </controls:CodexInputGroup>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Button addon">
    <controls:CodexInputGroup>
      <controls:CodexInputGroupInput Text="https://x.com/shadcn" />
      <controls:CodexInputGroupAddon Align="InlineEnd">
        <controls:CodexInputGroupButton Content="Search" />
      </controls:CodexInputGroupAddon>
    </controls:CodexInputGroup>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Keyboard hint">
    <controls:CodexInputGroup>
      <controls:CodexInputGroupInput PlaceholderText="Search docs" />
      <controls:CodexInputGroupAddon Align="InlineEnd">
        <controls:CodexKbd Content="Ctrl K" />
      </controls:CodexInputGroupAddon>
    </controls:CodexInputGroup>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Select composition">
    <controls:CodexInputGroup>
      <controls:CodexInputGroupInput PlaceholderText="Enter file name" />
      <controls:CodexInputGroupAddon Align="InlineEnd">
        <controls:CodexSelect Width="118"
                              SelectedIndex="0">
          <ComboBoxItem Content="All files" />
          <ComboBoxItem Content="Docs" />
          <ComboBoxItem Content="Code" />
        </controls:CodexSelect>
      </controls:CodexInputGroupAddon>
    </controls:CodexInputGroup>
  </controls:CodexField>
</Grid>
