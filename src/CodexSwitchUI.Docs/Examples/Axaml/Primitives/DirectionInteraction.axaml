<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Provider event"
                       Description="Direction changes update FlowDirection, classes, and event status.">
    <controls:CodexField.Content>
      <StackPanel Spacing="10">
        <primitives:CodexText Role="Muted"
                              Text="Direction is LeftToRight." />
        <controls:CodexDirection Direction="LeftToRight">
          <controls:CodexCard Title="Runtime language surface"
                              Description="Switch direction without rebuilding the form.">
            <StackPanel Spacing="10">
              <controls:CodexField Label="Provider"
                                   Description="Child fields and action rows inherit the active direction.">
                <controls:CodexField.Content>
                  <controls:CodexTextBox Width="260"
                                         Text="Localized value" />
                </controls:CodexField.Content>
              </controls:CodexField>
              <StackPanel Orientation="Horizontal"
                          Spacing="8">
                <controls:CodexBadge Content="Action row"
                                     Variant="Secondary" />
                <controls:CodexButton Content="Cancel"
                                      Size="Small"
                                      Variant="Outline" />
                <controls:CodexButton Content="Continue"
                                      Size="Small" />
              </StackPanel>
            </StackPanel>
          </controls:CodexCard>
        </controls:CodexDirection>
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <controls:CodexButton Content="Switch direction"
                                Size="Small"
                                Variant="Secondary" />
          <controls:CodexButton Content="Force LTR"
                                Size="Small"
                                Variant="Ghost" />
          <controls:CodexButton Content="Force RTL"
                                Size="Small"
                                Variant="Ghost" />
        </StackPanel>
      </StackPanel>
    </controls:CodexField.Content>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="RTL form alignment"
                       Description="Fields, inputs, and action rows inherit direction like Web document islands.">
    <controls:CodexField.Content>
      <controls:CodexDirection Direction="RightToLeft">
        <StackPanel Spacing="10">
          <controls:CodexField Label="Email"
                               Description="Trailing controls mirror with the provider.">
            <controls:CodexField.Content>
              <controls:CodexTextBox Width="260"
                                     Text="member@example.com" />
            </controls:CodexField.Content>
          </controls:CodexField>
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <controls:CodexBadge Content="Actions"
                                 Variant="Secondary" />
            <controls:CodexButton Content="Cancel"
                                  Size="Small"
                                  Variant="Outline" />
            <controls:CodexButton Content="Save"
                                  Size="Small" />
          </StackPanel>
        </StackPanel>
      </controls:CodexDirection>
    </controls:CodexField.Content>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Nested code island"
                       Description="RTL shells can keep command snippets and provider routes LTR.">
    <controls:CodexField.Content>
      <controls:CodexDirection Direction="RightToLeft">
        <StackPanel Spacing="10">
          <primitives:CodexText Role="Muted"
                                Text="Outer action order follows RTL." />
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <controls:CodexBadge Content="Command"
                                 Variant="Secondary" />
            <controls:CodexButton Content="Previous"
                                  Size="Small"
                                  Variant="Outline" />
            <controls:CodexButton Content="Next"
                                  Size="Small" />
          </StackPanel>
          <controls:CodexDirection Direction="LeftToRight">
            <primitives:CodexText Role="Code"
                                  Text="curl https://api.example.test/v1/models" />
          </controls:CodexDirection>
        </StackPanel>
      </controls:CodexDirection>
    </controls:CodexField.Content>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Disabled guard"
                       Description="Direction state remains visible while the provider is disabled.">
    <controls:CodexField.Content>
      <controls:CodexDirection Direction="RightToLeft"
                               IsEnabled="False">
        <controls:CodexCard Title="Disabled RTL"
                            Description="Opacity changes; layout direction remains RTL.">
          <StackPanel Spacing="10">
            <controls:CodexField Label="Provider"
                                 Description="Right-to-left content inherits mirrored layout.">
              <controls:CodexField.Content>
                <controls:CodexTextBox Width="260"
                                       Text="RTL value" />
              </controls:CodexField.Content>
            </controls:CodexField>
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <controls:CodexBadge Content="Action row"
                                   Variant="Secondary" />
              <controls:CodexButton Content="Cancel"
                                    Size="Small"
                                    Variant="Outline" />
              <controls:CodexButton Content="Continue"
                                    Size="Small" />
            </StackPanel>
          </StackPanel>
        </controls:CodexCard>
      </controls:CodexDirection>
    </controls:CodexField.Content>
  </controls:CodexField>
</Grid>
