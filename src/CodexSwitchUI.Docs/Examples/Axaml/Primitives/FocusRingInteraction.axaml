<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexField Label="Visibility and geometry"
                       Description="Focus ring visibility, thickness, offset, and brush update through component properties.">
    <controls:CodexField.Content>
      <StackPanel Spacing="12">
        <primitives:CodexText Role="Muted"
                              Text="Ring is visible with 2px thickness and 2px offset." />
        <primitives:CodexFocusRing IsRingVisible="True"
                                   RingThickness="2"
                                   RingOffset="2">
          <controls:CodexButton Content="Focusable target" />
        </primitives:CodexFocusRing>
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <controls:CodexButton Content="Toggle ring"
                                Size="Small"
                                Variant="Secondary" />
          <controls:CodexButton Content="Cycle geometry"
                                Size="Small"
                                Variant="Ghost" />
          <controls:CodexButton Content="Request focus"
                                Size="Small"
                                Variant="Ghost" />
          <controls:CodexButton Content="Switch accent"
                                Size="Small"
                                Variant="Ghost" />
        </StackPanel>
      </StackPanel>
    </controls:CodexField.Content>
  </controls:CodexField>

  <controls:CodexField Grid.Column="1"
                       Label="Wrapped input target"
                       Description="Ring chrome wraps arbitrary focusable content without changing the child template.">
    <controls:CodexField.Content>
      <primitives:CodexFocusRing RingOffset="4">
        <controls:CodexTextBox Width="260"
                               Text="Keyboard focus" />
      </primitives:CodexFocusRing>
    </controls:CodexField.Content>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Label="Action surface"
                       Description="Secondary and destructive actions can share the same ring primitive.">
    <controls:CodexField.Content>
      <StackPanel Orientation="Horizontal"
                  Spacing="12">
        <primitives:CodexFocusRing RingThickness="3">
          <controls:CodexButton Content="Approve"
                                Variant="Secondary" />
        </primitives:CodexFocusRing>
        <primitives:CodexFocusRing RingBrush="{DynamicResource CodexSwitch.DestructiveBrush}">
          <controls:CodexButton Content="Delete"
                                Variant="Destructive" />
        </primitives:CodexFocusRing>
      </StackPanel>
    </controls:CodexField.Content>
  </controls:CodexField>

  <controls:CodexField Grid.Row="1"
                       Grid.Column="1"
                       Label="Disabled target"
                       Description="Disabled child controls remain visually wrapped while ignoring pointer activation.">
    <controls:CodexField.Content>
      <primitives:CodexFocusRing IsRingVisible="True">
        <controls:CodexButton Content="Disabled action"
                              IsEnabled="False" />
      </primitives:CodexFocusRing>
    </controls:CodexField.Content>
  </controls:CodexField>
</Grid>
