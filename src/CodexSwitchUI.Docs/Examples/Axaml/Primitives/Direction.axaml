<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      ColumnDefinitions="*,*"
      ColumnSpacing="16">
  <controls:CodexDirection Direction="LeftToRight">
    <controls:CodexCard Title="Left to right"
                        Description="Primary actions stay at the inline end.">
      <StackPanel Spacing="10">
        <controls:CodexField Label="Provider"
                             Description="Left-to-right content uses the default layout.">
          <controls:CodexField.Content>
            <controls:CodexTextBox Width="260"
                                   Text="LTR value" />
          </controls:CodexField.Content>
        </controls:CodexField>
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <controls:CodexBadge Content="Action row"
                               Variant="Secondary" />
          <controls:CodexButton Content="Cancel"
                                Size="Small"
                                Variant="Outline" />
          <controls:CodexButton Content="Continue"
                                Size="Small" />
        </StackPanel>
      </StackPanel>
    </controls:CodexCard>
  </controls:CodexDirection>

  <controls:CodexDirection Grid.Column="1"
                           Direction="RightToLeft">
    <controls:CodexCard Title="Right to left"
                        Description="The same row mirrors through FlowDirection.">
      <StackPanel Spacing="10">
        <controls:CodexField Label="Provider"
                             Description="Right-to-left content inherits mirrored layout.">
          <controls:CodexField.Content>
            <controls:CodexTextBox Width="260"
                                   Text="RTL value" />
          </controls:CodexField.Content>
        </controls:CodexField>
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <controls:CodexBadge Content="Action row"
                               Variant="Secondary" />
          <controls:CodexButton Content="Cancel"
                                Size="Small"
                                Variant="Outline" />
          <controls:CodexButton Content="Continue"
                                Size="Small" />
        </StackPanel>
      </StackPanel>
    </controls:CodexCard>
  </controls:CodexDirection>
</Grid>
