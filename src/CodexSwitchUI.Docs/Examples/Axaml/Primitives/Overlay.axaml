<Grid xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      Height="180">
  <controls:CodexToggle x:Name="OverlayToggle"
                        Content="Open overlay"
                        Size="Small"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
  <primitives:CodexOverlay IsOpen="{Binding IsChecked, ElementName=OverlayToggle}"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center">
    <controls:CodexCard Width="260"
                        Title="Overlay content"
                        Description="Scrim, hit testing, and dismissal state are owned by the primitive.">
      <controls:CodexButton Content="Dismiss"
                            Size="Small" />
    </controls:CodexCard>
  </primitives:CodexOverlay>
</Grid>
