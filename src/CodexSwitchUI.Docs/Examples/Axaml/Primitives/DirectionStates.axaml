<Grid xmlns="https://github.com/avaloniaui"
      xmlns:controls="using:CodexSwitchUI.Controls"
      xmlns:primitives="using:CodexSwitchUI.Primitives"
      ColumnDefinitions="*,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="16"
      RowSpacing="14">
  <controls:CodexDirection Direction="LeftToRight">
    <controls:CodexCard Title="LTR provider"
                        Description="direction-ltr class is active.">
      <StackPanel Spacing="10">
        <controls:CodexField Label="Provider"
                             Description="Left-to-right content uses the default layout.">
          <controls:CodexField.Content>
            <controls:CodexTextBox Width="260"
                                   Text="LTR value" />
          </controls:CodexField.Content>
        </controls:CodexField>
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <controls:CodexBadge Content="Action row"
                               Variant="Secondary" />
          <controls:CodexButton Content="Cancel"
                                Size="Small"
                                Variant="Outline" />
          <controls:CodexButton Content="Continue"
                                Size="Small" />
        </StackPanel>
      </StackPanel>
    </controls:CodexCard>
  </controls:CodexDirection>

  <controls:CodexDirection Grid.Column="1"
                           Direction="RightToLeft">
    <controls:CodexCard Title="RTL provider"
                        Description="direction-rtl class is active.">
      <StackPanel Spacing="10">
        <controls:CodexField Label="Provider"
                             Description="Right-to-left content inherits mirrored layout.">
          <controls:CodexField.Content>
            <controls:CodexTextBox Width="260"
                                   Text="RTL value" />
          </controls:CodexField.Content>
        </controls:CodexField>
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <controls:CodexBadge Content="Action row"
                               Variant="Secondary" />
          <controls:CodexButton Content="Cancel"
                                Size="Small"
                                Variant="Outline" />
          <controls:CodexButton Content="Continue"
                                Size="Small" />
        </StackPanel>
      </StackPanel>
    </controls:CodexCard>
  </controls:CodexDirection>

  <controls:CodexDirection Grid.Row="1"
                           Direction="RightToLeft">
    <controls:CodexCard Title="Nested override"
                        Description="Outer content is RTL; a child island opts back into LTR.">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal"
                    Spacing="8">
          <controls:CodexBadge Content="RTL action"
                               Variant="Secondary" />
          <controls:CodexButton Content="Cancel"
                                Size="Small"
                                Variant="Outline" />
          <controls:CodexButton Content="Apply"
                                Size="Small" />
        </StackPanel>
        <controls:CodexDirection Direction="LeftToRight">
          <controls:CodexField Label="LTR island"
                               Description="Code, API names, and paths can remain left-to-right.">
            <controls:CodexField.Content>
              <primitives:CodexText Role="Code"
                                    Text="route=openai/default" />
            </controls:CodexField.Content>
          </controls:CodexField>
        </controls:CodexDirection>
      </StackPanel>
    </controls:CodexCard>
  </controls:CodexDirection>

  <controls:CodexDirection Grid.Row="1"
                           Grid.Column="1"
                           Direction="RightToLeft"
                           IsEnabled="False">
    <controls:CodexCard Title="Disabled provider"
                        Description="Disabled state uses the shared opacity token without changing FlowDirection.">
      <StackPanel Orientation="Horizontal"
                  Spacing="8">
        <controls:CodexBadge Content="Disabled"
                             Variant="Secondary" />
        <controls:CodexButton Content="Back"
                              Size="Small"
                              Variant="Outline" />
        <controls:CodexButton Content="Continue"
                              Size="Small" />
      </StackPanel>
    </controls:CodexCard>
  </controls:CodexDirection>
</Grid>
